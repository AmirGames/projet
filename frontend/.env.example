# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Il n'y a pas d'API GraphQL : l'application parle à l'API REST ci-dessus.
# NEXT_PUBLIC_GRAPHQL_URL=

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_STRIPE=true

# Répartition sur plusieurs domaines (laisser vide pour rester sur un domaine unique)
# En production :
#   NEXT_PUBLIC_DOMAINE_PUBLIC=zupeat.com
#   NEXT_PUBLIC_DOMAINE_PRO=commercant.zupone.com
#   NEXT_PUBLIC_DOMAINE_LIVREUR=delivery.zupeat.com
# En local, ajoutez ces noms dans votre fichier hosts :
#   127.0.0.1   zupeat.local
#   127.0.0.1   commercant.zupone.local
#   127.0.0.1   delivery.zupeat.local
NEXT_PUBLIC_DOMAINE_PUBLIC=
NEXT_PUBLIC_DOMAINE_PRO=
NEXT_PUBLIC_DOMAINE_LIVREUR=
