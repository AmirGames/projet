# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Il n'y a pas d'API GraphQL : l'application parle à l'API REST ci-dessus.
# NEXT_PUBLIC_GRAPHQL_URL=

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_STRIPE=true

# Stripe : la clé *publiable* (pk_test_… en test), jamais la clé secrète.
# Sans elle, le tunnel affiche « paiement non configuré » à l'étape du paiement.
# Tableau de bord Stripe → Développeurs → Clés API.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Répartition sur plusieurs domaines (laisser vide pour rester sur un domaine unique)
# En production :
#   NEXT_PUBLIC_DOMAINE_GROUPE=manager.zupone.com    (l'équipe du groupe)
#   NEXT_PUBLIC_DOMAINE_PUBLIC=zupeat.com
#   NEXT_PUBLIC_DOMAINE_PRO=manager.zupeat.com       (les commerçants)
#   NEXT_PUBLIC_DOMAINE_LIVREUR=delivery.zupeat.com
#   NEXT_PUBLIC_DOMAINE_VITRINE=zupone.com        (la vitrine du groupe)
#   NEXT_PUBLIC_DOMAINE_DRIVE=zupdrive.com        (ZupDrive, à venir)
#   NEXT_PUBLIC_DOMAINE_CHAUFFEUR=driver.zupdrive.com  (chauffeurs ZupDrive, pas les livreurs)
# En local, ajoutez ces noms dans votre fichier hosts :
#   127.0.0.1   manager.zupone.local
#   127.0.0.1   zupeat.local
#   127.0.0.1   manager.zupeat.local
#   127.0.0.1   delivery.zupeat.local
NEXT_PUBLIC_DOMAINE_GROUPE=
NEXT_PUBLIC_DOMAINE_PUBLIC=
NEXT_PUBLIC_DOMAINE_PRO=
NEXT_PUBLIC_DOMAINE_LIVREUR=
NEXT_PUBLIC_DOMAINE_VITRINE=
NEXT_PUBLIC_DOMAINE_DRIVE=
NEXT_PUBLIC_DOMAINE_CHAUFFEUR=

# Assistant : variables serveur uniquement, jamais NEXT_PUBLIC.
# Même JSON et même secret que le backend ; mapping localhost interdit en production.
ASSISTANT_HOSTS={"localhost:3000":"one","127.0.0.1:3000":"one"}
ASSISTANT_GATEWAY_SECRET=
