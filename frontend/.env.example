# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_STRIPE=true

# Répartition sur plusieurs domaines (laisser vide pour rester sur un domaine unique)
# En local, ajoutez ces noms dans votre fichier hosts :
#   127.0.0.1   monsite.local
#   127.0.0.1   commercant.monsite.local
#   127.0.0.1   livreur.monsite.local
NEXT_PUBLIC_DOMAINE_PUBLIC=
NEXT_PUBLIC_DOMAINE_PRO=
NEXT_PUBLIC_DOMAINE_LIVREUR=
