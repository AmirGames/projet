# Configuration de l'API ZupEat

# URL du serveur backend
# Sur téléphone, localhost désigne le téléphone : utiliser l'IP du PC ou adb reverse.
# Pour développement sur réseau local : http://192.168.0.80:3001 (remplacer par l'IP de votre machine)
# Pour production : https://api.zupeat.com
EXPO_PUBLIC_API_URL=http://localhost:3001

# Site public pour les conditions, la confidentialité et la suppression du compte
EXPO_PUBLIC_SITE_URL=https://zupeat.com
