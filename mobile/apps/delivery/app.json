{
  "expo": {
    "name": "Zupone Livreur",
    "slug": "zupone-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "delivery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amir_games.delivery"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "enabled": false
    }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#007AFF",
          "sounds": [
            "./assets/sounds/new_course.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zupone transmet votre position pendant que vous êtes en ligne : elle décide des courses qui vous sont proposées et permet au client de suivre sa livraison."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "L'appareil photo sert à photographier le dépôt d'une commande et vos pièces justificatives.",
          "photosPermission": "La galerie sert à envoyer vos pièces justificatives."
        }
      ]
    ],
    "android": {
      "package": "com.amir_games.zuponedelivery"
    }
  }
}
