# ============================================================================
# Variables de l'environnement de démonstration — à copier en .env.demo à la
# racine du dépôt, SUR LE SERVEUR DE DÉMO (pas celui de production) :
#   cp deploy/env.demo.example .env.demo && nano .env.demo
# Ce fichier réel n'est JAMAIS versionné (.gitignore l'exclut).
#
# Volontairement absents : clés Stripe, SMTP réel, Twilio, VAPID, IBAN. Le
# docker-compose.demo.yml les neutralise de toute façon. N'y recopiez RIEN de
# .env.production, et surtout pas ses secrets JWT.
# ============================================================================

# --- Domaines (DNS A vers l'IP du serveur de démo) ---------------------------
DOMAINES_SITE="demo.zupeat.com, manager.demo.zupeat.com, delivery.demo.zupeat.com"
DOMAINE_API=api.demo.zupeat.com
EMAIL_LETSENCRYPT=contact@zupeat.com

FRONTEND_URL=https://demo.zupeat.com
SITE_URL=https://demo.zupeat.com
ALLOWED_ORIGINS=https://manager.demo.zupeat.com,https://delivery.demo.zupeat.com

# Répartition des espaces par domaine. Inscrite dans le site au build : après
# modification, relancer ./deploy/demo.sh up
NEXT_PUBLIC_DOMAINE_GROUPE=
NEXT_PUBLIC_DOMAINE_PUBLIC=demo.zupeat.com
NEXT_PUBLIC_DOMAINE_PRO=manager.demo.zupeat.com
NEXT_PUBLIC_DOMAINE_LIVREUR=delivery.demo.zupeat.com
NEXT_PUBLIC_DOMAINE_VITRINE=
NEXT_PUBLIC_DOMAINE_DRIVE=

# --- Base de données ---------------------------------------------------------
# Lettres et chiffres uniquement : openssl rand -hex 24
POSTGRES_PASSWORD=A_REMPLACER

# --- Sécurité : des secrets À PART de la production --------------------------
# openssl rand -hex 32 (deux valeurs différentes)
JWT_SECRET=A_REMPLACER
JWT_REFRESH_SECRET=A_REMPLACER_autre_valeur
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
LOG_LEVEL=info

# --- Adresses ----------------------------------------------------------------
ADDRESS_PROVIDER=ban+photon
ADDRESS_COUNTRIES=fr,be
EMAIL_FROM=demo@zupeat.com
