# Reverse proxy + HTTPS automatique (Let's Encrypt).
# Les domaines viennent de .env.production (DOMAINES_SITE, DOMAINE_API) ;
# chacun doit déjà pointer (enregistrement DNS A) vers l'IP du VPS.
{
	email {$EMAIL_LETSENCRYPT}
}

# L'API et le temps réel (Socket.IO : Caddy relaie les WebSockets tout seul).
{$DOMAINE_API} {
	encode zstd gzip
	# L'assistant passe par le relais Next.js signé, jamais par l'API publique.
	@assistant path /api/assistant /api/assistant/*
	respond @assistant 404
	# Photos de produits, pièces justificatives : 10 Mo côté API, un peu de marge ici.
	request_body {
		max_size 25MB
	}
	# Toutes les instances de l'API (docker compose up --scale backend=N),
	# retrouvées par le DNS de Docker. Un navigateur reste sur la même
	# instance (cookie) : sans cela, le repli de Socket.IO en long-polling
	# enverrait ses requêtes à une instance qui ne connaît pas la session.
	# Redis relie ensuite les instances pour la diffusion des événements.
	reverse_proxy {
		dynamic a backend 3001 {
			refresh 10s
		}
		lb_policy cookie zup_api
		lb_retries 2
	}
}

# Le site : un seul déploiement Next.js sert tous les domaines publics, le
# proxy de l'application aiguille selon l'hôte demandé.
{$DOMAINES_SITE} {
	encode zstd gzip

	# www.zupeat.com, www.zupone.com… : une seule adresse par site. Servi tel
	# quel, www n'était reconnu par aucun espace et affichait la page des
	# commerçants à la place de l'accueil.
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	reverse_proxy frontend:3000 {
		# Ces en-têtes ne sont créés que par le serveur Next.js après vérification.
		header_up -X-Assistant-Time
		header_up -X-Assistant-Host
		header_up -X-Assistant-Surface
		header_up -X-Assistant-Signature
	}
}
