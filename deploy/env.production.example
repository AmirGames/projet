# ============================================================================
# Variables de production — à copier en .env.production à la racine du dépôt
#   cp deploy/env.production.example .env.production && nano .env.production
# Ce fichier réel n'est JAMAIS versionné (.gitignore l'exclut).
#
# Générer un secret : openssl rand -hex 32
# ============================================================================

# --- Domaines ---------------------------------------------------------------
# Tous doivent avoir un enregistrement DNS A vers l'IP publique du VPS AVANT
# le premier lancement, sinon Let's Encrypt refuse le certificat.
#
# Domaines servis par le site, séparés par des virgules. Les www. sont
# redirigés vers l'adresse sans www (voir deploy/Caddyfile).
DOMAINES_SITE="zupeat.com, www.zupeat.com, manager.zupeat.com, delivery.zupeat.com, zupone.com, www.zupone.com, manager.zupone.com, zupdrive.com, www.zupdrive.com"
# Domaine de l'API (sans https://).
DOMAINE_API=api.zupeat.com
# Adresse prévenue par Let's Encrypt si un certificat expire.
EMAIL_LETSENCRYPT=contact@zupeat.com

# Adresse principale du site, et les autres domaines autorisés à appeler l'API.
FRONTEND_URL=https://zupeat.com
SITE_URL=https://zupeat.com
ALLOWED_ORIGINS=https://manager.zupeat.com,https://delivery.zupeat.com,https://manager.zupone.com,https://zupone.com,https://zupdrive.com
# Le panneau de la plateforme, pour les liens des alertes de surveillance.
PLATEFORME_URL=https://manager.zupone.com
# Connexion unique entre les domaines : l'adresse qui garde la session (la
# vitrine du groupe, NEXT_PUBLIC_DOMAINE_VITRINE). Vide : chaque domaine garde
# sa propre session, comme avant.
SSO_ORIGIN=https://zupone.com

# Répartition des espaces par domaine (laisser vide pour un domaine unique).
# Inscrites dans le site au build : après modification, relancer ./deploy/zup.sh up
NEXT_PUBLIC_DOMAINE_GROUPE=manager.zupone.com
NEXT_PUBLIC_DOMAINE_PUBLIC=zupeat.com
NEXT_PUBLIC_DOMAINE_PRO=manager.zupeat.com
NEXT_PUBLIC_DOMAINE_LIVREUR=delivery.zupeat.com
NEXT_PUBLIC_DOMAINE_VITRINE=zupone.com
NEXT_PUBLIC_DOMAINE_DRIVE=zupdrive.com

# --- Base de données --------------------------------------------------------
# Lettres et chiffres uniquement (le mot de passe entre dans une URL) :
#   openssl rand -hex 24
POSTGRES_USER=zupone
POSTGRES_DB=zupone
POSTGRES_PASSWORD=A_REMPLACER

# --- Sécurité ---------------------------------------------------------------
JWT_SECRET=A_REMPLACER_openssl_rand_hex_32
JWT_REFRESH_SECRET=A_REMPLACER_autre_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
LOG_LEVEL=info

# --- Stripe (clés LIVE en production) ---------------------------------------
# Webhook à déclarer dans Stripe : https://<DOMAINE_API>/api/payments/webhook
ENABLE_STRIPE=true
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Courriels (SMTP) -------------------------------------------------------
# Par ex. Scaleway Transactional Email : smtp.tem.scw.cloud, port 465 (SMTP_SECURE=true)
# ou 587 (SMTP_SECURE=false). Utilisateur = ID du projet Scaleway, mot de passe = clé API.
SMTP_HOST=smtp.tem.scw.cloud
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@zupeat.com
ENABLE_EMAIL_VERIFICATION=true
REQUIRE_EMAIL_VERIFICATION=false

# --- Adresses ---------------------------------------------------------------
ADDRESS_PROVIDER=ban+photon
ADDRESS_COUNTRIES=fr,be
GOOGLE_MAPS_API_KEY=

# --- Notifications (facultatif) ---------------------------------------------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@zupeat.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=32

# --- Virements SEPA ---------------------------------------------------------
SEPA_DEBTOR_NAME="Nom de la société"
SEPA_DEBTOR_IBAN=
# SEPA_DEBTOR_BIC=
# PAYOUTS_START_DATE=2026-10-05

# --- Surveillance -----------------------------------------------------------
# MONITORING_ALERT_EMAILS=astreinte@zupeat.com
# MONITORING_WEBHOOK_URL=
# Disponibilité sur 90 jours (page Monitoring) : l'API et FRONTEND_URL sont
# sondés d'office ; chaque autre domaine s'ajoute ici, « Libellé|adresse ».
UPTIME_URLS=Espace commerçant|https://manager.zupeat.com,Espace livreur|https://delivery.zupeat.com,Plateforme|https://manager.zupone.com,Vitrine Zupone|https://zupone.com,Vitrine ZupDrive|https://zupdrive.com
