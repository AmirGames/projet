# ============================================================================
# Variables de production — à copier en .env.production à la racine du dépôt
#   cp deploy/env.production.example .env.production && nano .env.production
# Ce fichier réel n'est JAMAIS versionné (.gitignore l'exclut).
#
# Phase 6 RGPD : aucun démarrage en production sans ces secrets indépendants.
# Générer et conserver les valeurs dans un coffre ; ne jamais committer le fichier rempli.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY=
PRIVACY_AUDIT_KEY=
FILE_SIGNING_SECRET=
# Renseigner true après migration et privacy:check (voir docs/rgpd).
PRIVACY_MIGRATION_VERIFIED=false
# Clé publique age ; la clé privée de restauration reste hors du VPS.
AGE_BACKUP_RECIPIENT=
# Copie hors du VPS des sauvegardes (déjà chiffrées par age), destination rclone,
# par exemple scaleway:mon-bucket/zupone. Vide : aucune copie hors serveur.
BACKUP_REMOTE=
# Générer un secret : openssl rand -hex 32
# ============================================================================

# --- Domaines ---------------------------------------------------------------
# Tous doivent avoir un enregistrement DNS A vers l'IP publique du VPS AVANT
# le premier lancement, sinon Let's Encrypt refuse le certificat.
#
# Domaines servis par le site, séparés par des virgules. Les www. sont
# redirigés vers l'adresse sans www (voir deploy/Caddyfile).
DOMAINES_SITE="zupeat.com, www.zupeat.com, manager.zupeat.com, delivery.zupeat.com, zupone.com, www.zupone.com, manager.zupone.com, zupdrive.com, www.zupdrive.com, driver.zupdrive.com"
# Domaine de l'API (sans https://).
DOMAINE_API=api.zupeat.com
# Adresse prévenue par Let's Encrypt si un certificat expire.
EMAIL_LETSENCRYPT=contact@zupeat.com

# Adresse principale du site, et les autres domaines autorisés à appeler l'API.
FRONTEND_URL=https://zupeat.com
SITE_URL=https://zupeat.com
ALLOWED_ORIGINS=https://manager.zupeat.com,https://delivery.zupeat.com,https://manager.zupone.com,https://zupone.com,https://zupdrive.com,https://driver.zupdrive.com
# Le panneau de la plateforme, pour les liens des alertes de surveillance.
PLATEFORME_URL=https://manager.zupone.com
# Connexion unique entre les domaines : l'adresse qui garde la session (la
# vitrine du groupe, NEXT_PUBLIC_DOMAINE_VITRINE). Vide : chaque domaine garde
# sa propre session, comme avant.
SSO_ORIGIN=https://zupone.com

# Répartition des espaces par domaine (laisser vide pour un domaine unique).
# Inscrites dans le site au build : après modification, relancer ./deploy/zup.sh up
NEXT_PUBLIC_DOMAINE_GROUPE=manager.zupone.com
NEXT_PUBLIC_DOMAINE_PUBLIC=zupeat.com
NEXT_PUBLIC_DOMAINE_PRO=manager.zupeat.com
NEXT_PUBLIC_DOMAINE_LIVREUR=delivery.zupeat.com
NEXT_PUBLIC_DOMAINE_VITRINE=zupone.com
NEXT_PUBLIC_DOMAINE_DRIVE=zupdrive.com
# L'espace des chauffeurs ZupDrive (transport de personnes, pas les livreurs).
NEXT_PUBLIC_DOMAINE_CHAUFFEUR=driver.zupdrive.com

# --- Base de données --------------------------------------------------------
# Lettres et chiffres uniquement (le mot de passe entre dans une URL) :
#   openssl rand -hex 24
POSTGRES_USER=zupone
POSTGRES_DB=zupone
POSTGRES_PASSWORD=A_REMPLACER

# --- Superowner --------------------------------------------------------------
# Le compte propriétaire de la plateforme. Aucune inscription n'en donne les
# droits : le conteneur le crée au démarrage à partir de ces lignes, une seule
# fois — ensuite elles ne servent plus et peuvent être vidées.
# Plutôt que le mot de passe en clair, son empreinte bcrypt, ENTRE APOSTROPHES
# (sinon Docker Compose lit les « $ » comme des variables) :
#   docker run --rm node:22-alpine sh -c "cd /tmp && npm i -s bcryptjs >/dev/null && node -e \"console.log(require('bcryptjs').hashSync(process.argv[1], 10))\" 'VotreMotDePasse1'"
SUPEROWNER_EMAIL=
SUPEROWNER_PASSWORD_HASH=
# SUPEROWNER_PASSWORD=     (au lieu de l'empreinte : 8 caractères, un chiffre, une minuscule, une majuscule)

# --- Sécurité ---------------------------------------------------------------
JWT_SECRET=A_REMPLACER_openssl_rand_hex_32
JWT_REFRESH_SECRET=A_REMPLACER_autre_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=info

# --- Stripe (clés LIVE en production) ---------------------------------------
# Webhook à déclarer dans Stripe : https://<DOMAINE_API>/api/payments/webhook
ENABLE_STRIPE=true
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Courriels (SMTP) -------------------------------------------------------
# Par ex. Scaleway Transactional Email : smtp.tem.scw.cloud, port 465 (SMTP_SECURE=true)
# ou 587 (SMTP_SECURE=false). Utilisateur = ID du projet Scaleway, mot de passe = clé API.
SMTP_HOST=smtp.tem.scw.cloud
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@zupeat.com
ENABLE_EMAIL_VERIFICATION=true
# Connexion refusée tant que l'adresse n'est pas confirmée. Non définie, elle
# est exigée en production (NODE_ENV=production). Ne la mettez à false que le
# temps que des comptes créés avant cette règle confirment leur adresse.
# REQUIRE_EMAIL_VERIFICATION=false

# --- Base de données : rôle des migrations (facultatif) ---------------------
# Le service « migrate » applique les migrations avant l'API. Par défaut il
# emploie le même rôle SQL qu'elle. Pour séparer les droits (l'API ne modifie
# pas le schéma), créez le rôle d'exécution avec deploy/roles-sql.sql, mettez
# ses identifiants dans DATABASE_URL_APP, et gardez ici le rôle propriétaire.
# DATABASE_URL_MIGRATION=postgresql://zupone:MOT_DE_PASSE@postgres:5432/zupone?schema=public

# --- Adresses ---------------------------------------------------------------
ADDRESS_PROVIDER=ban+photon
ADDRESS_COUNTRIES=fr,be
GOOGLE_MAPS_API_KEY=

# --- Notifications (facultatif) ---------------------------------------------
# Push navigateur : ./deploy/zup.sh vapid remplit ces deux clés tout seul.
# Ne plus les changer ensuite : les abonnements existants deviendraient muets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@zupeat.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=32

# --- Virements SEPA ---------------------------------------------------------
SEPA_DEBTOR_NAME="Nom de la société"
SEPA_DEBTOR_IBAN=
# SEPA_DEBTOR_BIC=
# PAYOUTS_START_DATE=2026-10-05

# --- Itinéraire des courses ZupDrive ------------------------------------------
# estimation (défaut) ou osrm (OSRM_API_URL : votre instance OSRM, données de la
# Belgique). Voir backend/.env.example.
ROUTING_PROVIDER=estimation
# OSRM_API_URL=http://osrm:5000

# --- Surveillance -----------------------------------------------------------
# MONITORING_ALERT_EMAILS=astreinte@zupeat.com
# MONITORING_WEBHOOK_URL=
# Disponibilité sur 90 jours (page Monitoring) : l'API et FRONTEND_URL sont
# sondés d'office ; chaque autre domaine s'ajoute ici, « Libellé|adresse ».
UPTIME_URLS=Espace commerçant|https://manager.zupeat.com,Espace livreur|https://delivery.zupeat.com,Plateforme|https://manager.zupone.com,Vitrine Zupone|https://zupone.com,Vitrine ZupDrive|https://zupdrive.com,Espace chauffeur ZupDrive|https://driver.zupdrive.com

# --- Commerce de démonstration ----------------------------------------------
# Un compte commerçant public : ses identifiants s'affichent sur la page de
# connexion, il est remis à zéro chaque nuit à 3 h. Jamais listé aux clients,
# jamais commandable, sans accès aux coordonnées bancaires ni aux envois.
# Le mot de passe est public : n'en réutilisez aucun.
# DEMO_MERCHANT_ENABLED=true
# DEMO_MERCHANT_EMAIL=demo@zupeat.com
# DEMO_MERCHANT_PASSWORD=

# ZupDrive : true = une course n'est proposée aux chauffeurs qu'une fois payée en ligne.
# À passer à true quand l'écran de paiement de zupdrive.com/trajet est déployé.
ZUPDRIVE_PAIEMENT_OBLIGATOIRE=false

# Webhook d'accusés de notification ZupDrive : secret >=32 caractères partagé avec le fournisseur d'envoi.
# Vide = le webhook répond 503 (rien n'est accepté sans signature).
ZUPDRIVE_NOTIFICATIONS_WEBHOOK_SECRET=

# Content-Security-Policy du site (frontend/lib/csp.ts), serveur uniquement.
#   report-only : phase d'observation, rien n'est bloqué ; les violations
#                 arrivent dans la page Monitoring (catégorie CSP) — défaut ;
#   enforce     : la politique est appliquée (après une période sans violation
#                 légitime, y compris sur le paiement Stripe et les cartes) ;
#   off         : plus d'en-tête dynamique (retour arrière immédiat).
CSP_MODE=report-only

# Assistant local gratuit (profil Docker assistant-local, aucun port public).
ASSISTANT_PROVIDER=ollama
ASSISTANT_OLLAMA_URL=http://ollama:11434
ASSISTANT_OLLAMA_MODEL=qwen3:1.7b
# Pour une release reproductible, renseigner une image Ollama vérifiée avec digest.
ASSISTANT_OLLAMA_IMAGE=ollama/ollama:latest
# Secret interne de sécurité du relais (pas une clé d'un fournisseur IA).
ASSISTANT_GATEWAY_SECRET=
ASSISTANT_HOSTS={"zupeat.com":"eat","manager.zupeat.com":"eat-manager","delivery.zupeat.com":"eat-delivery","zupone.com":"one","manager.zupone.com":"one-manager","zupdrive.com":"drive","driver.zupdrive.com":"drive-driver"}
