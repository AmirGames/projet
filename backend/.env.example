# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_dev?schema=public"

# Node environment
NODE_ENV=development

# Server
PORT=3001
API_URL=http://localhost:3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------------------------------------------
# Temps réel sur plusieurs instances
#
# Avec une seule instance de l'API, inutile. Dès qu'on en lance plusieurs,
# Redis les relie : sans lui, un événement émis sur l'une n'atteint pas les
# navigateurs branchés sur l'autre. Si Redis ne répond pas au démarrage, l'API
# reste sur une seule instance et le dit dans ses journaux.
# REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Prévus, mais branchés sur rien à ce jour
#
# Ces variables sont acceptées par la configuration sans qu'aucun code ne les
# lise : les renseigner ne fait rien. Les courriels partent par SMTP
# (voir plus bas), pas par SendGrid ; il n'y a ni file d'attente Redis, ni
# hébergement d'images Cloudinary, ni remontée d'erreurs Sentry.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# SENTRY_DSN=
# ----------------------------------------------------------------------------

# Stripe. STRIPE_WEBHOOK_SECRET est le secret de signature de l'endpoint
# POST /api/payments/webhook (tableau de bord Stripe, ou en local :
# `stripe listen --forward-to localhost:3001/api/payments/webhook`).
# Événements à abonner : payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled, charge.refunded, refund.failed, refund.updated.
# Sans ce secret, le webhook répond 503 et les commandes restent « en attente ».
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Logging
LOG_LEVEL=debug

# Surveillance (page Administration → Surveillance)
# Les alertes partent par courriel aux comptes plateforme ; ajoutez d'autres
# adresses, séparées par des virgules, et/ou un webhook Slack/Discord/Mattermost.
# MONITORING_ALERT_EMAILS=astreinte@exemple.fr
# MONITORING_WEBHOOK_URL=https://hooks.slack.com/services/...
# MONITORING_ALERTS=false   # coupe toutes les alertes (la page reste active)

# Feature flags
ENABLE_STRIPE=true
ENABLE_EMAIL_VERIFICATION=true

# Domaines supplémentaires autorisés à appeler l API, séparés par des virgules
# Exemple : https://zupeat.com,https://commercant.zupone.com,https://livreur.zupone.com
ALLOWED_ORIGINS=

# Adresse du site dans les liens envoyés par courriel (confirmation, mot de
# passe oublié). À défaut, FRONTEND_URL est utilisé.
SITE_URL=http://localhost:3000

# Serveur de courriel sortant. En développement, Mailpit sur 1025 affiche les
# messages sans rien expédier.
#
# 127.0.0.1 et non localhost : Node résout localhost en IPv6 (::1) alors que
# Mailpit n'écoute souvent qu'en IPv4, d'où un ECONNREFUSED ::1:1025
# déroutant.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@monsite.fr

# Envoyer un lien de confirmation à l'inscription (true par défaut).
ENABLE_EMAIL_VERIFICATION=true

# Refuser la connexion tant que l'adresse n'est pas confirmée.
# Laissez false jusqu'à ce que votre propre adresse soit confirmée : sinon
# tous les comptes déjà créés, le vôtre compris, se retrouvent dehors.
REQUIRE_EMAIL_VERIFICATION=false

# Afficher chaque requête SQL dans la console. Très bavard : le balayage des
# courses tourne toutes les cinq secondes.
PRISMA_LOG_QUERIES=false

# Recherche d'adresses.
#   ban    — Base Adresse Nationale : la base officielle française, la plus
#            précise sur la France, mais elle s'arrête aux frontières.
#   photon — OpenStreetMap, couverture mondiale, sans clé d'API. Moins fin sur
#            la France, mais il répond partout.
#   ban+photon — les deux : la BAN pour la France, Photon pour le reste. C'est
#            ce qu'il faut dès qu'un pays voisin s'ajoute, sans rien perdre de
#            la précision française. Les doublons sont écartés, la BAN d'abord.
#   google — Places API (New). La meilleure pertinence sur une saisie
#            approximative, et la couverture la plus large. PAYANT, et exige
#            GOOGLE_MAPS_API_KEY ci-dessous. Les trois premiers sont gratuits.
ADDRESS_PROVIDER=ban+photon

# Limiter les résultats à certains pays (codes ISO, séparés par des virgules).
# Vide = partout. Sans effet sur la BAN, qui ne connaît que la France et la rend
# toujours : ce réglage ne filtre donc que l'apport de Photon.
# Exemple : fr,be,ch,lu
ADDRESS_COUNTRIES=fr,be

# Adresses des services, à ne changer que pour viser une instance à vous.
# ADDRESS_API_URL=https://api-adresse.data.gouv.fr/search/
# PHOTON_API_URL=https://photon.komoot.io/api/
# GOOGLE_PLACES_API_URL=https://places.googleapis.com/v1

# Clé Google, nécessaire seulement si ADDRESS_PROVIDER=google.
#
# Elle reste sur le serveur : la requête part de l'API, jamais du navigateur.
# Restreignez-la donc par ADRESSE IP (celle de votre serveur) et non par
# référent HTTP, et n'autorisez qu'« Places API (New) ». Une clé sans
# restriction qui fuit se consomme en heures.
#
# Sans clé, le fournisseur se déclare injoignable — la saisie manuelle prend le
# relais — plutôt que de rendre une liste vide qu'on lirait « aucune adresse ne
# correspond ».
#
# Ce fichier est un exemple versionné : la vraie clé va dans .env, jamais ici.
GOOGLE_MAPS_API_KEY=

# --- Notifications livreurs / clients (facultatif) ---------------------------
# Push navigateur (Web Push). Générer une paire avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# SMS via Twilio. Sans ces trois variables, aucun SMS n'est envoyé.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Indicatif appliqué aux numéros saisis sans (06… → +336…)
SMS_DEFAULT_COUNTRY_CODE=32
