{
  "name": "saas-backend",
  "version": "0.1.0",
  "description": "SaaS Backend - Digitalisation Commerces Locaux",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "format": "prettier --write .",
    "lint": "eslint src --ext .ts",
    "verif": "node scripts/verification/tout.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.2.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.9",
    "redis": "^6.2.1",
    "socket.io": "^4.7.2",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.6.2"
  },
  "optionalDependencies": {
    "cloudinary": "^2.11.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/stripe": "^8.0.416",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
