{
  "name": "saas-backend",
  "version": "0.1.0",
  "description": "SaaS Backend - Digitalisation Commerces Locaux",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "format": "prettier --write .",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "bcrypt": "latest",
    "bull": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "nodemailer": "^10.0.9",
    "redis": "latest",
    "stripe": "^22.6.2",
    "winston": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/stripe": "^8.0.416",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "prisma": "^5.22.0",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
