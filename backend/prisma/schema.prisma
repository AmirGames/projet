// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

/// Journal RGPD indépendant du compte ; acteur pseudonymisé par HMAC.
/// La migration interdit les modifications et la suppression avant 180 jours.
model PrivacyAuditEvent {
  id        String @id @default(cuid())
  actor     String
  action    String
  target    String
  outcome   String
  integrity String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([actor, createdAt])
}

/// Empêche la réintroduction d'un profil effacé lors d'une restauration.
model ErasureRecord {
  id        String @id @default(cuid())
  subjectId String
  scope     String
  erasedAt  DateTime @default(now())
  @@unique([subjectId, scope])
  @@index([erasedAt])
}

model PrivacyErasureRequest {
  userId      String @id
  status      String @default("PENDING")
  requestedAt DateTime @default(now())
  completedAt DateTime?
  @@index([status, requestedAt])
}

/// Gel ciblé et réexaminable, jamais un report indéfini de toute suppression.
model PrivacyLegalHold {
  id        String @id @default(cuid())
  model     String
  recordId  String
  reason    String
  createdBy String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([model, recordId])
  @@index([expiresAt])
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  emailVerified Boolean   @default(false)
  // Empreintes, jamais les jetons eux-mêmes : une lecture de la base ne doit
  // pas suffire à confirmer une adresse ni à s'emparer d'un compte.
  emailTokenHash String?  @unique
  emailTokenExpiresAt DateTime?
  resetTokenHash String?  @unique
  resetTokenExpiresAt DateTime?
  /// Dernier changement de mot de passe : un jeton émis avant est refusé,
  /// ce qui ferme les sessions ouvertes ailleurs.
  passwordChangedAt DateTime?
  isSystemAdmin Boolean   @default(false)
  /// Un seul compte au plus : index unique partiel "User_un_seul_superowner"
  /// (migration 0020), que Prisma ne sait pas décrire ici. Jamais attribué à
  /// l'inscription — voir src/cli/create-superowner.ts.
  isSuperOwner  Boolean   @default(false)
  /// Rôles dans l'équipe du groupe, un par plateforme (ZupEat, ZupDrive…).
  /// Ce qu'ils ouvrent se règle dans PlatformRole ; le superowner n'en a pas
  /// besoin, il voit tout.
  accesEquipe   AccesEquipe[]
  status        String    @default("ACTIVE") // ACTIVE, BANNED, SUSPENDED

  // Relations
  memberships   Membership[]
  auditLogs     SystemAuditLog[]
  driver        Courier?
  /// Le dossier chauffeur ZupDrive : transport de personnes, licence LVC.
  /// Sans rapport avec `driver` ci-dessus (modèle Courier), le livreur de
  /// repas ZupEat.
  chauffeurDrive ChauffeurDrive?
  /// La société ZupDrive dont ce compte est le gérant (une au plus).
  societeDrive   SocieteDrive?
  /// Les trajets commandés comme passager sur ZupDrive.
  coursesDrive  CourseDrive[]
  /// Les notes reçues comme passager ZupDrive, de ses chauffeurs.
  notesRecuesDrive NoteCourseDrive[]
  /// Les évaluations que ce passager a données sur les chauffeurs.
  ratingsGiven  RatingCourseDrive[]
  /// Les paiements Stripe pour trajets ZupDrive.
  paymentsIntentDrive PaymentIntentDrive[]
  /// Ses adresses « Domicile » et « Travail » pour commander un trajet ZupDrive.
  adressesFavoritesDrive AdresseFavoriteDrive[]
  /// La personne à prévenir en cas d'alerte SOS pendant un trajet ZupDrive.
  contactConfianceDrive ContactConfianceDrive?
  /// Ses alertes SOS ZupDrive.
  alertesSosDrive AlerteSosDrive[]
  /// Les notifications in-app de cet utilisateur.
  notificationsDrive NotificationDrive[]
  customer      Customer?  // REFONTE IDENTITÉ UNIFIÉE: Relation inverse
  ticketMessages TicketMessage[]
  pushDevices   PushDevice[]
  sessionsConnexion SessionConnexion[]
  mfaFactor MfaFactor?
  assistantConversations AssistantConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Assistant ZupOne : un domaine et un propriétaire/session par conversation.
model AssistantConversation {
  id String @id @default(cuid())
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  guestHash String?
  host String
  service String
  category String?
  agentId String?
  orgId String?
  storeId String?
  segment Int @default(0)
  revision Int @default(0)
  state String @default("OPEN")
  busyUntil DateTime?
  expiresAt DateTime
  messages AssistantMessage[]
  actions AssistantAction[]
  executions AssistantToolExecution[]
  handoffs AssistantHandoff[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, host, updatedAt])
  @@index([guestHash, host])
  @@index([expiresAt])
}

model AssistantMessage {
  id String @id @default(cuid())
  conversationId String
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientKey String
  author String
  content String
  service String
  agentId String?
  segment Int
  state String @default("COMPLETE")
  mode String
  createdAt DateTime @default(now())
  @@unique([conversationId, clientKey, author])
  @@index([conversationId, segment, createdAt])
}

model AssistantAction {
  id String @id @default(cuid())
  conversationId String
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId String
  tool String
  params Json
  target String
  summary String
  segment Int
  state String @default("PENDING")
  expiresAt DateTime
  confirmedAt DateTime?
  result Json?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  @@index([conversationId, state])
}

model AssistantToolExecution {
  id String @id @default(cuid())
  conversationId String
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId String?
  tool String
  target String?
  status String
  code String?
  startedAt DateTime @default(now())
  completedAt DateTime @default(now())
  @@index([conversationId, startedAt])
}

/// Extension du support pour les visiteurs/clients/chauffeurs sans organisation.
/// Les commerçants conservent un lien vers MerchantTicket.
model AssistantHandoff {
  id String @id @default(cuid())
  conversationId String
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  segment Int
  service String
  specialty String
  reason String
  priority String @default("MEDIUM")
  summary String
  verified Boolean
  ticketId String?
  state String @default("OPEN")
  reply String?
  repliedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([conversationId, segment])
  @@index([service, state, createdAt])
}

/// Un groupe de l'équipe de la plateforme et ce qu'il peut faire dans l'espace
/// superowner. Les permissions se cochent depuis cet espace, par le superowner
/// seul : `{ "<section>": "read" | "write" }`, une section absente est fermée.
/// Les plateformes du groupe ZupOne. Une nouvelle plateforme s'ajoute ici.
enum Plateforme {
  EAT
  DRIVE
}

/// Les groupes de l'équipe (SuperAdmin, Administrateur, Support) et leurs
/// permissions, cochées par le superowner — plateforme par plateforme : un
/// Support ZupEat n'ouvre pas les mêmes sections qu'un Support ZupDrive.
model PlatformRole {
  plateforme  Plateforme @default(EAT)
  code        String
  label       String
  permissions Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([plateforme, code])
}

/// Le rôle d'un membre de l'équipe sur une plateforme. Une même personne peut
/// être SuperAdmin sur ZupEat et Support sur ZupDrive, ou n'avoir accès qu'à
/// l'une des deux.
model AccesEquipe {
  userId     String
  plateforme Plateforme
  /// SUPER_ADMIN, ADMIN ou SUPPORT.
  role       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, plateforme])
  @@index([plateforme, role])
}

/// Téléphone sur lequel l'application mobile est installée et connectée.
/// Le jeton Expo Push permet de prévenir le compte même application fermée.
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?  // ios, android
  app       String?  // merchant, delivery, customer

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// ORGANIZATIONS & MULTI-TENANCY
// ============================================================================

enum OrganizationTier {
  FREE
  PREMIUM
  PRO
}

// Le contenu d'une formule — son nom, son prix, ce qu'elle autorise.
//
// Les trois codes restent fixes : ils servent de clé à Organization.tier. Ce
// qui se vend derrière, en revanche, se règle depuis l'espace plateforme :
// écrit en dur, il fallait modifier le code pour changer un tarif.
model PlanTier {
  code         OrganizationTier @id
  label        String
  maxStores    Int
  monthlyPrice Decimal          @default(0) @db.Decimal(10, 2)
  /// La commission prélevée sur les ventes, en pourcentage. Elle n'existait
  /// qu'en réglage global : toutes les formules payaient le même taux, et rien
  /// ne permettait de faire payer moins cher un abonnement plus élevé.
  commissionPercent Decimal      @default(5) @db.Decimal(5, 2)
  /// La commission quand le commerçant confie ses livraisons aux livreurs de
  /// la plateforme. Plus élevée : la plateforme trouve, suit et paie le
  /// livreur. `commissionPercent` ne s'applique qu'à celui qui livre lui-même.
  platformDeliveryCommissionPercent Decimal @default(15) @db.Decimal(5, 2)
  // Arguments de vente, une phrase par ligne.
  features     Json             @default("[]")
  // L'ordre de la grille, et donc la formule proposée à la suivante.
  displayOrder Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id       String            @id @default(cuid())
  name     String
  email    String?
  slug     String            @unique
  tier     OrganizationTier  @default(FREE)
  plan     String            @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE
  status   String            @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED, INACTIVE

  /// Le commerce de démonstration : un compte public, dont les identifiants
  /// s'affichent sur la page de connexion. Jamais listé aux clients, jamais
  /// commandable, jamais reversé, sans accès aux coordonnées bancaires ni aux
  /// envois. Remis à zéro chaque nuit (voir demo.service.ts).
  isDemo   Boolean           @default(false)
  /// Empreinte (IP + navigateur) du dernier visiteur du commerce de démo, et
  /// sa dernière activité : de quoi remettre la démo à zéro quand il part, ou
  /// qu'un autre arrive après lui. Vides hors démo et juste après une remise
  /// à zéro.
  demoVisiteurHash String?
  demoActiviteAt   DateTime?

  // Suspension info
  suspensionReason    String?
  suspensionDate      DateTime?

  // Closure info
  closureReason       String?
  closureDate         DateTime?
  closedUntil         DateTime?   // Auto-suppression le jour X (60j après fermeture)

  // Archive info
  archiveBackupId     String?     // ID du backup MerchantArchive
  isArchivedPermanently Boolean   @default(false)

  /// L'identité de facturation du commerce.
  ///
  /// La plateforme lui facture une commission et lui doit des versements, sans
  /// rien savoir de lui : ni raison sociale, ni adresse de facturation, ni
  /// numéro de TVA, ni compte où virer. Une facture sans ces mentions n'en est
  /// pas une.
  legalName           String?
  vatNumber           String?
  registrationNumber  String?     // SIRET en France, BCE en Belgique
  billingAddress      String?
  billingPostalCode   String?
  billingCity         String?
  billingCountry      String?     @default("France")

  /// Son adresse sur le réseau Peppol, « 0208:0123456789 » (schéma:valeur).
  /// Vide : on la déduit de son numéro de TVA belge ou de son numéro BCE.
  peppolId            String?

  /// Le propriétaire du commerce, la personne physique derrière la société.
  ownerFirstName      String?
  ownerLastName       String?
  ownerEmail          String?
  ownerPhone          String?
  ownerBirthDate      DateTime?

  /// Le compte à créditer.
  ///
  /// L'IBAN n'est jamais rendu en entier : les écrans n'en montrent que les
  /// quatre derniers caractères, assez pour reconnaître son compte, pas assez
  /// pour s'en servir ailleurs.
  iban                String?
  bic                 String?
  accountHolder       String?

  /// La promo « zéro commission », accordée à la main par la plateforme.
  ///
  /// Tant qu'elle court, aucune commission n'est prélevée sur les ventes du
  /// commerçant, quelle que soit sa formule ou qui livre. Sans date de fin,
  /// elle dure jusqu'à ce qu'on la retire.
  commissionFreeActive Boolean   @default(false)
  commissionFreeUntil  DateTime?
  commissionFreeNote   String?

  /// Les conditions négociées à la main avec un gros compte (une enseigne, une
  /// chaîne) : elles remplacent, champ par champ, celles de sa formule. Un champ
  /// vide laisse la formule s'appliquer. La promo « zéro commission » passe
  /// toujours avant.
  customCommissionPercent                 Decimal? @db.Decimal(5, 2)
  customPlatformDeliveryCommissionPercent Decimal? @db.Decimal(5, 2)
  customMaxStores                         Int?
  customMonthlyPrice                      Decimal? @db.Decimal(10, 2)
  customTermsNote                         String?

  /// La validation du commerce par la plateforme.
  ///
  /// Tant qu'elle manque, le commerçant prépare sa boutique — catalogue,
  /// catégories, horaires — mais ne peut ni l'ouvrir, ni recevoir de commande,
  /// ni apparaître dans les listes du client. Distincte de `Store.isOpen`, qui
  /// reste le bouton du commerçant : un champ qu'il pourrait basculer lui-même
  /// ne validerait rien.
  approvedAt          DateTime?
  approvedBy          String?

  // Relations
  stores              Store[]
  merchantPayouts     MerchantPayout[]
  memberships         Membership[]
  tickets             MerchantTicket[]
  commissionHistory   CommissionHistory[]
  archive             MerchantArchive?
  documents           OrganizationDocument[]
  platformInvoices    PlatformInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([closedUntil])
}

/// La facture que la plateforme émet à un commerçant pour un mois : commission,
/// frais de livraison et frais de service qu'il a encaissés pour elle.
///
/// Facture B2B entre deux assujettis belges : elle doit partir en UBL sur le
/// réseau Peppol. Figée à l'émission, comme `Invoice` — le vendeur, l'acheteur,
/// les lignes et le XML ne se réécrivent pas.
model PlatformInvoice {
  id          String   @id @default(cuid())
  /// Numéro légal, sans trou : ZE-2026-000001
  number      String   @unique
  orgId       String
  /// Le mois facturé, « 2026-08 ». Une seule facture par commerçant et par mois.
  period      String
  issuedAt    DateTime
  dueAt       DateTime

  sellerJson  Json
  buyerJson   Json
  linesJson   Json
  vatRate     Decimal  @db.Decimal(5, 2)
  totalExcl   Decimal  @db.Decimal(10, 2)
  vatAmount   Decimal  @db.Decimal(10, 2)
  totalIncl   Decimal  @db.Decimal(10, 2)
  /// Ce qui a déjà été réglé par retenue sur les reversements du lundi. Le reste
  /// (totalIncl - prepaidAmount) est ce que le commerçant doit encore payer.
  prepaidAmount Decimal @default(0) @db.Decimal(10, 2)

  /// La facture UBL (Peppol BIS 3.0) telle qu'elle est transmise.
  ublXml      String

  /// GENERATED (prête à envoyer), SENT (remise à l'Access Point), DELIVERED
  /// (accusée par le destinataire), FAILED (à corriger ou à renvoyer).
  peppolStatus    String    @default("GENERATED")
  peppolMessageId String?
  peppolError     String?
  peppolSentAt    DateTime?
  peppolAttempts  Int       @default(0)

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, period])
  @@index([peppolStatus])
  @@index([issuedAt])
}

/// Le compteur des factures de la plateforme, par année.
model PlatformInvoiceSeq {
  year Int @id
  last Int @default(0)
}

/// Une pièce justificative du commerçant : Kbis, statuts, pièce d'identité.
///
/// La plateforme n'avait aucun moyen de lui demander un justificatif, ni lui de
/// le fournir : tout se serait échangé par courriel, hors du service.
model OrganizationDocument {
  id          String    @id @default(cuid())
  orgId       String
  type        String    // registration, identity, vat, bank, other
  /// Le document lui-même. L'hébergement de fichiers n'étant pas branché, le
  /// commerçant fournit un lien ; le jour où un stockage existera, c'est ce
  /// champ qui le recevra.
  documentUrl String
  fileName    String?
  expiryDate  DateTime?
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  /// Le motif d'un refus, que le commerçant doit pouvoir lire.
  reviewNote  String?
  reviewedAt  DateTime?
  /// Le jour où le commerçant a été prévenu de l'expiration prochaine. Sans
  /// lui, la surveillance le relancerait à chaque passage ; un nouveau dépôt
  /// le remet à zéro.
  expiryReminderAt DateTime?

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([status])
}

enum MembershipRole {
  ADMIN
  STORE_MANAGER
  STORE_STAFF
}

model Membership {
  id      String         @id @default(cuid())
  userId  String
  orgId   String
  role    MembershipRole
  storeIds String[]      @default([]) // JSON array of store IDs this user can access

  // Relations
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

// ============================================================================
// SYSTEM ADMINISTRATION
// ============================================================================

model SystemConfig {
  id                  String    @id @default(cuid())
  platformFeePercent  Decimal   @default(5.0) @db.Decimal(5, 2)
  minOrderAmount      Decimal   @default(0) @db.Decimal(10, 2)
  maxOrderAmount      Decimal   @default(9999.99) @db.Decimal(10, 2)
  maintenanceMode     Boolean   @default(false)
  maintenanceMessage  String?
  selectedTheme       String    @default("dark")

  // Rémunération des livreurs et attribution des courses
  driverBaseFee       Decimal   @default(2.50) @db.Decimal(10, 2)
  driverPerKmFee      Decimal   @default(0.80) @db.Decimal(10, 2)
  // Délai laissé au livreur pour accepter avant de passer au suivant
  driverOfferSeconds  Int       @default(30)
  // Au-delà, on ne propose plus la course
  driverMaxRadiusKm   Float     @default(8)
  // Distance maximale d'une livraison (commerce → client) selon le véhicule.
  // Jamais au-delà de driverMaxRadiusKm. La voiture n'a pas de limite propre.
  driverBikeMaxKm     Float     @default(4)
  driverScooterMaxKm  Float     @default(7)
  // Une course sans preneur s'ouvre ensuite aux livreurs dont le véhicule est
  // trop limité pour elle (ils peuvent refuser), après ce délai.
  driverExceptionSeconds Int    @default(180)
  // Livreur « bientôt libre » : à moins de ce rayon du client qu'il livre, ou à
  // moins de ce délai de la fin de l'attente à la porte, on peut lui proposer
  // la course suivante. 0 et 0 : jamais.
  driverSoonFreeKm       Float  @default(1)
  driverSoonFreeSeconds  Int    @default(180)
  // Plusieurs courses à la fois (tournée) : combien au plus (1 = jamais de
  // regroupement), clients « au même endroit », détour accepté.
  driverMaxCourses    Int       @default(3)
  driverGroupClientKm Float     @default(2)
  driverGroupDetourKm Float     @default(2)

  // Frais de service ajoutés à chaque commande du client. Ils reviennent à la
  // plateforme, jamais au commerçant. 0 les supprime.
  serviceFee          Decimal   @default(0.25) @db.Decimal(10, 2)

  // Settings JSON for additional configurations
  settings            Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MerchantTicket {
  id              String    @id @default(cuid())
  orgId           String
  title           String
  description     String
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  category        String    // TECHNICAL, BILLING, ACCOUNT, OTHER

  // Archivage (uniquement pour les tickets fermés)
  archivedAt      DateTime?

  // Relations
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?

  @@index([orgId])
  @@index([status])
  @@index([createdAt])
  @@index([archivedAt])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String
  authorName  String
  // MERCHANT ou ADMIN : détermine le côté affiché dans la conversation
  authorRole  String
  body        String

  // Relations
  ticket      MerchantTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model CommissionHistory {
  id              String    @id @default(cuid())
  orgId           String
  amount          Decimal   @db.Decimal(10, 2)
  percentage      Decimal   @db.Decimal(5, 2)
  period          String    // Monthly period like "2024-01"
  ordersCount     Int
  totalRevenue    Decimal   @db.Decimal(10, 2)

  // Relations
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([period])
}

model SystemAuditLog {
  id              String    @id @default(cuid())
  adminId         String
  action          String
  target          String    // Which merchant or system component
  changes         Json?     // What changed

  /// D'où l'action a été faite. La table ne gardait rien : le journal affichait
  /// une section « Informations réseau » vide, ce qui la rendait inutile pour
  /// distinguer deux administrateurs ou repérer un accès inhabituel.
  ipAddress       String?
  userAgent       String?

  // Relations
  admin           User      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ============================================================================
// MERCHANT ARCHIVE & CLOSURE
// ============================================================================

model MerchantArchive {
  id                      String    @id @default(cuid())
  organizationId          String    @unique

  // Backup data (complete snapshot)
  organizationData        Json      // Entire Organization object
  storesData              Json?     // Array of Store objects
  productsData            Json?     // Array of Product objects
  ordersData              Json?     // Array of Order objects
  customersData           Json?     // Array of Customer objects

  // Archive metadata
  reason                  String    // Why archived (closure reason)
  closureDate             DateTime
  restorationDeadline     DateTime  // After this date, no restore possible

  // Status
  isRestored              Boolean   @default(false)
  restoredAt              DateTime?
  restoredByAdminId       String?

  // Relations
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt               DateTime  @default(now())

  @@index([organizationId])
  @@index([closureDate])
  @@index([restorationDeadline])
}

// ============================================================================
// STORES (ESTABLISHMENTS)
// ============================================================================

model Store {
  id            String    @id @default(cuid())
  orgId         String
  name          String
  slug          String
  address       String?
  city          String?
  postalCode    String?
  /// Le pays de la boutique, code ISO en minuscules (« fr », « be »), déduit
  /// de son adresse à chaque changement. Il décide des régions du site
  /// (/fr-fr/, /be-fr/…) dans lesquelles elle est listée ; vide, elle l'est
  /// partout plutôt que nulle part.
  countryCode   String?
  phone         String?
  email         String?
  description   String?

  /// Ce que vend ce commerce, et ce qu'on y mange.
  ///
  /// L'inscription ne le demandait pas : toute boutique était un « restaurant »
  /// sans genre, et le client ne pouvait ni filtrer par type de commerce ni
  /// chercher une pizzeria.
  businessType  String?   // restaurant, grocery, supermarket, deli, liquor, florist, pharmacy, shop
  cuisineType   String?   // pizza, japanese-sushi, burgers… sans objet hors restauration

  /// L'identité de facturation propre à cette boutique.
  ///
  /// Vide, c'est celle de l'organisation qui s'applique — le cas courant :
  /// plusieurs points de vente sous une même société. Renseignée, elle prime :
  /// trois commerces peuvent relever de trois sociétés, donc de trois numéros
  /// de TVA.
  legalName          String?
  vatNumber          String?
  registrationNumber String?

  // GÉOLOCALISATION - Pour Uber Eats like
  latitude      Float?    // Pour trouver restaurants proches
  longitude     Float?

  // Store settings (JSON)
  settings      Json      @default("{}")

  /// Horaires par jour, en plusieurs plages : un service le midi, un autre le
  /// soir. Une fermeture antérieure à l'ouverture se termine le lendemain.
  /// { "MON": { "closed": false, "plages": [{ "open": "11:30", "close": "14:00" },
  ///                                        { "open": "17:30", "close": "01:00" }] } }
  /// L'ancienne forme { open, close, closed } reste lue.
  operatingHours Json     @default("{}")

  // Pickup slots (JSON array)
  // Example: [{ start: "11:00", end: "13:00", maxOrders: 10 }, ...]
  pickupSlots   Json      @default("[]")

  // Quick store status
  isOpen        Boolean   @default(true)

  // Delivery options
  acceptsDelivery Boolean @default(true)   // Accept delivery orders
  acceptsPickup   Boolean @default(true)   // Accept pickup orders
  deliveryCost    Decimal @default(0) @db.Decimal(10, 2)
  minDeliveryAmount Decimal @default(0) @db.Decimal(10, 2)

  // Rating
  rating        Decimal   @default(5.0) @db.Decimal(3, 2)
  totalRatings  Int       @default(0)

  // Soft delete
  deletedAt     DateTime?

  // Relations
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products      Product[]
  categories    Category[]
  orders        Order[]
  theme         Theme? @relation("ThemeToStore")
  deliveryZones DeliveryZone[]
  promotions    Promotion[]
  staff         Staff[]
  reviews       Review[] @relation("ReviewToStore")
  campaigns     MarketingCampaign[] @relation("CampaignToStore")
  taxSettings   TaxSetting[] @relation("TaxSettingToStore")
  invoiceSeqs   InvoiceSeq[] @relation("InvoiceSeqToStore")
  invoices      Invoice[]    @relation("InvoiceToStore")
  paymentMethods PaymentMethod[] @relation("PaymentMethodToStore")
  notifications Notification[] @relation("NotificationToStore")
  tags          ProductTag[] @relation("TagToStore")
  favorites     FavoriteStore[] @relation("StoreFavorites")
  customerCarts CustomerCart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([deletedAt])
  @@index([countryCode])
  customerEntries StoreCustomer[]
}

// ============================================================================
// PRODUCTS & CATALOG
// ============================================================================

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

/// Les 14 allergènes à déclaration obligatoire (règlement (UE) 1169/2011, annexe II).
enum Allergen {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOYBEANS
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  sku         String
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  categoryId  String?
  stock       Int           @default(0)
  lowStockThreshold Int     @default(10)
  // Disponibilité du jour, gérée à la main par le commerçant. Le suivi
  // chiffré du stock viendra plus tard, par ingrédients et recettes.
  isAvailable Boolean       @default(true)
  displayOrder Int          @default(0)
  status      ProductStatus @default(DRAFT)

  // La question posée au client quand le plat se décline : « Type de pâtes »,
  // « Taille ». Vide, le plat n'a qu'une forme.
  variantLabel String?

  // Allergènes : `allergensDeclared` distingue « aucun allergène » (true, liste
  // vide) de « le commerçant n'a rien renseigné » (false).
  allergens         Allergen[] @default([])
  allergensDeclared Boolean    @default(false)
  // Produit contenant de l'alcool : vente interdite aux mineurs.
  containsAlcohol   Boolean    @default(false)

  // Soft delete
  deletedAt   DateTime?

  // Relations
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  reviews     Review[] @relation("ReviewToProduct")
  media       ProductMedia[] @relation("MediaToProduct")
  seo         ProductSeo? @relation("SeoToProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  order     Int     @default(0)

  // Relations
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([order])
}

enum CategorySortMode {
  MANUAL
  ALPHA_ASC
  ALPHA_DESC
  PRICE_ASC
  PRICE_DESC
}

model Category {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  displayOrder Int    @default(0)

  /// Comment les produits de cette catégorie s'affichent : dans l'ordre que
  /// le commerçant a fixé au glisser-déposer (MANUAL, la valeur par défaut,
  /// qui ne change rien pour les catégories existantes), ou recalculés à la
  /// volée par nom ou par prix. S'applique à la fois au tableau de bord du
  /// commerçant et à la vitrine du client — les deux doivent montrer le même
  /// ordre.
  sortMode    CategorySortMode @default(MANUAL)

  // Relations
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

/// Un groupe de suppléments d'un plat : « Suppléments », « Sauces ».
model ProductOption {
  id          String  @id @default(cuid())
  productId   String
  name        String  // "Suppléments", "Sauce"
  // Les choix : [{ id, label, price, isAvailable }]. Le prix se saisit comme
  // celui du plat (HT si la boutique travaille hors taxe) ; 0 pour un choix
  // offert. Voir SupplementService.
  choices     Json    @default("[]")
  // Au moins un choix exigé (une sauce obligatoire, par exemple).
  isRequired  Boolean @default(false)
  // Au plus tant de choix dans ce groupe ; vide, sans limite.
  maxChoices  Int?
  displayOrder Int    @default(0)
  pricingType String  @default("fixed") // "fixed" : chaque choix a son prix

  // Relations
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  sku         String
  // Ce que lit le client : « Penne », « Spaghetti », « Tagliatelle ». Sans
  // libellé propre, une commande ne pouvait nommer que le plat parent.
  label       String  @default("")
  // L'ordre voulu par le commerçant, comme pour les produits.
  displayOrder Int    @default(0)
  // combination is JSON: { optionId: choiceId }
  combination Json    @default("{}")
  // Vide, la variante est au prix du plat : une déclinaison ne coûte pas
  // toujours plus cher.
  price       Decimal? @db.Decimal(10, 2)
  stock       Int     @default(0)
  isAvailable Boolean @default(true)

  // Relations
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

// ============================================================================
// ORDERS
// ============================================================================

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  REJECTED
  READY
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// Encaissé puis rendu au client : commande refusée ou annulée.
  REFUNDED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

model Order {
  id              String       @id @default(cuid())
  storeId         String
  customerId      String?      // nullable for guest checkout

  // Items
  items           OrderItem[]

  // Customer contact
  customerName    String
  customerEmail   String
  customerPhone   String

  // Delivery info
  deliveryType    DeliveryType
  pickupTime      DateTime?    // if PICKUP
  deliveryAddress String?      // if DELIVERY
  deliveryCity    String?
  deliveryPostal  String?
  // Coordonnées du point de livraison. L'autocomplétion les fournit au moment
  // de la commande ; sans elles, aucune distance ni durée ne peut être
  // calculée pour le suivi.
  deliveryLat     Float?
  deliveryLng     Float?

  // Status
  status          OrderStatus  @default(PENDING)

  /// L'heure à laquelle la commande est parvenue au commerçant.
  ///
  /// Payée sur place : aussitôt passée. Payée par carte : seulement quand
  /// Stripe a confirmé l'encaissement — le commerçant ne doit pas préparer une
  /// commande que le client n'a jamais réglée. Vide, la commande n'existe pas
  /// encore pour lui : ni liste, ni sonnerie, ni délai de réponse.
  submittedAt     DateTime?    @default(now())

  // Payment
  totalAmount     Decimal      @db.Decimal(10, 2)
  taxAmount       Decimal      @db.Decimal(10, 2)
  feesAmount      Decimal      @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?      // Stripe payment intent ID

  /// Le taux de TVA appliqué, tel qu'il valait au moment de la commande.
  ///
  /// `taxAmount` arrivait du navigateur et valait donc zéro : la taxe réglée par
  /// le commerçant n'était lue nulle part. Elle est maintenant calculée au
  /// serveur, et son taux conservé — un commerçant qui passe de 10 à 20 % ne
  /// doit pas réécrire la TVA de ses tickets déjà remis.
  taxRate         Decimal      @default(0) @db.Decimal(5, 2)

  /// La commission de la plateforme, figée à la commande.
  ///
  /// Elle se recalculait à chaque affichage de la facturation, au taux de la
  /// formule *actuelle* du commerçant : changer sa formule refacturait tout son
  /// historique au nouveau taux. Dans un sens la plateforme perdait de l'argent,
  /// dans l'autre elle en réclamait indûment.
  commissionPercent Decimal    @default(0) @db.Decimal(5, 2)
  commissionAmount  Decimal    @default(0) @db.Decimal(10, 2)
  /// La formule du commerçant à cet instant, pour expliquer le taux retenu.
  tierAtOrder       String?
  /// La commande est tombée pendant une promo « zéro commission ». Sa
  /// commission vaut 0 et le reste : sans cette marque, un montant nul passe
  /// pour « pas encore figé » et se refacture au taux du jour.
  commissionWaived  Boolean    @default(false)
  /// Qui livre cette commande, figé à la commande : OWN (le commerçant, avec
  /// ses livreurs) ou PLATFORM (un livreur de la plateforme). Il décide du taux
  /// de commission, et de ce que deviennent les frais de livraison : gardés par
  /// le commerçant, ou encaissés par la plateforme puis versés au livreur.
  /// Nul pour une commande à emporter.
  deliveryMode      String?
  /// Les frais de service payés par le client, figés à la commande. Ils sont
  /// à la plateforme : hors du chiffre du commerçant et de l'assiette de sa
  /// commission, et réclamés sur son relevé tant qu'il encaisse pour elle.
  serviceFeeAmount  Decimal    @default(0) @db.Decimal(10, 2)
  /// Le pourboire laissé au livreur de la plateforme. À part du total de la
  /// commande (totalAmount) : il n'entre ni dans le chiffre d'affaires du
  /// commerçant ni dans l'assiette de la commission, et revient en entier au
  /// livreur (ajouté à sa rémunération à l'attribution). Le client paie
  /// totalAmount + tipAmount.
  tipAmount       Decimal      @default(0) @db.Decimal(10, 2)

  // Le code promo appliqué, et la remise qu'il a réellement accordée. Aucun des
  // deux n'était conservé : la remise disparaissait de la commande, et le
  // commerçant ne savait pas quel code avait été utilisé.
  promoCode       String?
  discountAmount  Decimal      @default(0) @db.Decimal(10, 2)

  // Le moyen de paiement choisi par le client parmi ceux du commerçant. Gardé
  // par identifiant et par nom : le nom reste lisible même si le commerçant
  // retire le moyen de paiement plus tard.
  paymentMethodId   String?
  paymentMethodName String?

  notes           String?

  /// L'empreinte SHA-256 du jeton de suivi remis au client à la commande.
  ///
  /// Le suivi public se lisait avec le seul identifiant de la commande, qui
  /// n'a rien de secret (URL, SMS, journaux, réponses de l'espace livreur) :
  /// n'importe qui en lisait le code de remise et les coordonnées du client.
 …16427 tokens truncated…ComplianceReportDrive[]
  ratings      RatingCourseDrive[]
  complianceChecks ComplianceCheck[]
  documentWorkflows DocumentVerificationWorkflow[]
  chauffeurDocuments ChauffeurDocument[]
  infractions ChauffeurInfraction[]
  /// Où verser les gains : table à part pour que l'IBAN ne sorte jamais avec la fiche.
  compteBancaire CompteBancaireChauffeurDrive?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  alertesNotification NotificationAlert[]

  @@index([societeId])
}

/// Le compte bancaire où le chauffeur reçoit ses versements hebdomadaires.
/// Table à part (et non des colonnes de ChauffeurDrive) : la fiche est lue et
/// renvoyée en entier par plusieurs routes, l'IBAN ne doit jamais les suivre.
/// iban, bic et accountHolder sont chiffrés (voir ENCRYPTED_FIELDS) ; l'API ne
/// rend jamais que les 4 derniers caractères de l'IBAN.
model CompteBancaireChauffeurDrive {
  id            String   @id @default(cuid())
  chauffeurId   String   @unique
  /// Normalisé (sans espaces, majuscules) et validé (clé modulo 97) avant écriture.
  iban          String
  bic           String?
  accountHolder String

  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Une société ZupDrive (taxi, VTC) : elle détient les licences, assure les
/// véhicules et emploie des chauffeurs, qui roulent pour elle. Son dossier
/// suit le même cycle que celui d'un chauffeur (BROUILLON, SOUMIS, VALIDE,
/// REFUSE, SUSPENDU) et se valide par l'équipe ZupDrive.
model SocieteDrive {
  id       String @id @default(cuid())
  /// Le compte ZupOne du gérant : une société par gérant.
  gerantId String @unique

  raisonSociale    String
  /// Numéro BCE, 10 chiffres sans points : une société n'est inscrite qu'une fois.
  numeroEntreprise String? @unique
  /// BRUXELLES, WALLONIE ou FLANDRE : la région de ses licences. Ses
  /// chauffeurs roulent dans cette région.
  region           String?
  telephone        String?

  /// BROUILLON, SOUMIS, VALIDE, REFUSE, SUSPENDU.
  statut      String    @default("BROUILLON")
  motifStatut String?
  soumisLe    DateTime?
  valideLe    DateTime?
  validePar   String?

  /// Restrict : la société et l'historique de ses courses ne partent pas avec
  /// le compte du gérant (voir customer-account.service.ts).
  gerant      User                     @relation(fields: [gerantId], references: [id], onDelete: Restrict)
  documents   DocumentChauffeurDrive[]
  vehicules   VehiculeDrive[]
  chauffeurs  ChauffeurDrive[]
  invitations InvitationSocieteDrive[]
  courses     CourseDrive[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
}

/// Un véhicule d'une société ZupDrive, avec ses pièces (licence, assurance,
/// contrôle technique, immatriculation). Un chauffeur de société ne roule
/// qu'avec un véhicule conforme.
model VehiculeDrive {
  id        String @id @default(cuid())
  societeId String

  marque        String
  modele        String
  /// En majuscules, sans espaces ni tirets. Unique parmi les véhicules non
  /// retirés (index partiel, migration 0038).
  plaque        String
  numeroLicence String?

  /// Toutes ses pièces exigées sont validées et en cours de validité.
  /// Recalculé par le serveur à chaque examen et à chaque expiration
  /// (SocieteDriveService.recalculerVehicule) : ce n'est jamais une saisie.
  conforme Boolean   @default(false)
  /// Retiré par la société : gardé pour l'historique des courses.
  retireLe DateTime?

  societe   SocieteDrive             @relation(fields: [societeId], references: [id], onDelete: Cascade)
  documents DocumentChauffeurDrive[]
  chauffeur ChauffeurDrive?
  courses   CourseDrive[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societeId])
}

/// L'invitation d'une société à un chauffeur, par adresse e-mail. Personne
/// n'est rattaché à une société sans avoir accepté. Au plus une invitation en
/// attente par société et par adresse (index partiel, migration 0038).
model InvitationSocieteDrive {
  id        String    @id @default(cuid())
  societeId String
  /// En minuscules.
  email     String
  /// EN_ATTENTE, ACCEPTEE, REFUSEE, ANNULEE.
  statut    String    @default("EN_ATTENTE")
  reponduLe DateTime?

  societe SocieteDrive @relation(fields: [societeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, statut])
  @@index([societeId, statut])
}

/// Une version d'une pièce ZupDrive : celle d'un chauffeur, d'une société
/// ou d'un véhicule de société — exactement l'un des trois (contrainte
/// CHECK, migration 0038).
///
/// Par type, au plus une version « en vigueur » (validée, ou expirée) et une
/// version déposée en attente d'examen (ou refusée). Renouveler une pièce
/// validée n'efface pas l'ancienne : elle reste en vigueur jusqu'à ce que
/// l'équipe valide la nouvelle, puis elle est archivée (archiveeLe).
model DocumentChauffeurDrive {
  id             String    @id @default(cuid())
  chauffeurId    String?
  societeId      String?
  vehiculeId     String?
  /// Voir TYPES_PIECE dans chauffeur-onboarding.service.ts.
  type           String
  /// Stockage privé (dossier « chauffeurs »), servi par /api/files.
  url            String
  dateExpiration DateTime?
  /// PENDING, APPROVED, REJECTED, EXPIRED.
  statut         String    @default("PENDING")
  /// Le motif d'un refus, que le chauffeur doit pouvoir lire.
  noteExamen     String?
  examineLe      DateTime?
  /// Relances d'expiration envoyées au chauffeur, 30 puis 10 jours avant.
  /// Posées une seule fois chacune ; un nouveau dépôt les remet à zéro.
  rappel30JoursLe DateTime?
  rappel10JoursLe DateTime?
  /// Version remplacée par une version plus récente, validée par l'équipe.
  /// Gardée pour l'historique ; seules les versions non archivées comptent.
  archiveeLe      DateTime?

  chauffeur ChauffeurDrive? @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  societe   SocieteDrive?   @relation(fields: [societeId], references: [id], onDelete: Cascade)
  vehicule  VehiculeDrive?  @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chauffeurId, type])
  @@index([societeId, type])
  @@index([vehiculeId, type])
  @@index([statut])
  @@index([dateExpiration])
}

// ============================================================================
// ZUPDRIVE — COURSES (transport de personnes)
// ============================================================================

/// Le tarif d'une région, fixé par l'équipe ZupDrive. Tous les montants sont
/// des entiers en centimes d'euro. Prix d'une course, calculé une fois à la
/// commande puis figé (voir tarification-drive.service.ts) :
///   max(minimum, priseEnCharge + parKm × km + parMinute × minutes),
///   arrondi au centime le plus proche, une seule fois, sur le total.
model TarifDrive {
  /// BRUXELLES, WALLONIE ou FLANDRE : une licence ne vaut que dans sa région.
  region                 String   @id
  priseEnChargeCentimes  Int
  parKmCentimes          Int
  parMinuteCentimes      Int
  minimumCentimes        Int
  /// Le service n'est ouvert à la commande que dans une région active.
  actif                  Boolean  @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Une course ZupDrive : un passager, un trajet, un prix fixe, un chauffeur.
///
/// RECHERCHE → ACCEPTEE → ARRIVEE → EN_COURS → TERMINEE, ou ANNULEE, ou
/// SANS_CHAUFFEUR quand personne n'a accepté à temps. Transitions contrôlées
/// par des écritures conditionnées à l'état attendu.
model CourseDrive {
  id           String   @id @default(cuid())
  /// Nul une fois le compte du passager supprimé : la course reste dans
  /// l'historique, sans la personne (comme les commandes ZupEat).
  passagerId   String?
  /// Clé envoyée par le client : rejouer la commande rend la même course.
  cleIdempotence String

  chauffeurId  String?
  /// Figés à l'acceptation, dans la même transaction : la société pour qui le
  /// chauffeur roulait (à qui la course sera reversée, paiement en V2) et le
  /// véhicule utilisé. Nuls pour un chauffeur indépendant. Un chauffeur qui
  /// change de société ensuite ne change pas l'historique.
  societeId    String?
  vehiculeId   String?

  statut       String   @default("RECHERCHE")
  region       String

  departAdresse    String
  departLatitude   Float
  departLongitude  Float
  arriveeAdresse   String
  arriveeLatitude  Float
  arriveeLongitude Float

  /// Estimation au moment de la commande (distance routière estimée).
  distanceMetres   Int
  dureeSecondes    Int
  /// Le prix annoncé au passager et figé à la commande, en centimes d'euro.
  prixCentimes     Int
  /// Coefficient de majoration (demande/offre) appliqué au prix à la commande.
  /// Nul pour les courses créées avant son enregistrement : inconnu, pas 1.
  surgeFactor      Float?
  devise           String   @default("EUR")
  /// Le tarif appliqué, recopié : le prix reste explicable même si le tarif change.
  tarifApplique    Json

  accepteeLe  DateTime?
  arriveeLe   DateTime?
  debutLe     DateTime?
  termineeLe  DateTime?
  annuleeLe   DateTime?
  /// PASSAGER, CHAUFFEUR ou PLATEFORME.
  annuleePar  String?
  motifAnnulation String?

  passager  User?           @relation(fields: [passagerId], references: [id], onDelete: SetNull)
  chauffeur ChauffeurDrive? @relation(fields: [chauffeurId], references: [id], onDelete: SetNull)
  societe   SocieteDrive?   @relation(fields: [societeId], references: [id], onDelete: SetNull)
  vehicule  VehiculeDrive?  @relation(fields: [vehiculeId], references: [id], onDelete: SetNull)
  propositions   PropositionCourseDrive[]
  alerteSos      AlerteSosDrive?
  messages       MessageCourseDrive[]
  notes          NoteCourseDrive[]
  ratings        RatingCourseDrive[]
  paymentIntent  PaymentIntentDrive?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([passagerId, cleIdempotence])
  @@index([statut])
  @@index([chauffeurId, statut])
  @@index([passagerId, createdAt])
  @@index([societeId, createdAt])
}

/// Une course proposée à un chauffeur, qui a quelques secondes pour accepter.
model PropositionCourseDrive {
  id          String   @id @default(cuid())
  courseId    String
  chauffeurId String
  /// EN_ATTENTE, ACCEPTEE, REFUSEE, EXPIREE, CADUQUE (course annulée entre-temps).
  statut      String   @default("EN_ATTENTE")
  /// Distance du chauffeur au point de départ, au moment de la proposition.
  distanceMetres Int
  expireA     DateTime
  reponduLe   DateTime?

  course    CourseDrive    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Une course n'est proposée qu'une fois à un même chauffeur.
  @@unique([courseId, chauffeurId])
  @@index([statut, expireA])
  @@index([chauffeurId, statut])
}

/// La note d'une course terminée, dans un sens : le passager note son
/// chauffeur, le chauffeur note son passager. Une fois par sens et par course,
/// dans les 7 jours. Les moyennes sont recalculées depuis ces notes, jamais
/// entretenues à part (voir note-course-drive.service.ts).
model NoteCourseDrive {
  id          String   @id @default(cuid())
  courseId    String
  /// PASSAGER (il note le chauffeur) ou CHAUFFEUR (il note le passager).
  auteur      String
  /// Le chauffeur de la course : ses notes reçues sont celles des passagers.
  chauffeurId String
  /// Le passager de la course. Nul si son compte est supprimé : la note reste,
  /// sinon la moyenne du chauffeur bougerait à la suppression d'un compte.
  passagerId  String?
  /// De 1 à 5. Entier : une demi-étoile ne se donne pas.
  note        Int
  /// Lu par l'équipe ZupDrive seulement, jamais par la personne notée.
  commentaire String?

  course    CourseDrive    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  passager  User?          @relation(fields: [passagerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([courseId, auteur])
  @@index([chauffeurId, auteur])
  @@index([passagerId, auteur])
}

/// L'adresse « Domicile » ou « Travail » d'un passager ZupDrive, pour remplir
/// un trajet en un geste. Une seule par type et par compte. Donnée personnelle :
/// supprimée avec le compte (erasure.service) et incluse dans l'export.
model AdresseFavoriteDrive {
  id         String   @id @default(cuid())
  userId     String
  /// DOMICILE ou TRAVAIL.
  type       String
  adresse    String
  latitude   Float
  longitude  Float
  codePostal String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

/// La personne de confiance d'un passager ZupDrive : prévenue par e-mail quand
/// il déclenche une alerte SOS. `consentementLe` : le passager a confirmé avoir
/// informé cette personne. Donnée personnelle d'un tiers : supprimée avec le compte.
model ContactConfianceDrive {
  id             String   @id @default(cuid())
  userId         String   @unique
  nom            String
  email          String
  consentementLe DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Une alerte SOS déclenchée par un passager pendant un trajet ZupDrive.
/// Une seule par course (rejouer l'appel rend la même alerte). L'alerte est vraie
/// en base avant tout envoi : un échec de notification ne l'annule pas, et
/// `equipePrevenueLe` / `contactPrevenuLe` disent ce qui est réellement parti.
model AlerteSosDrive {
  id        String  @id @default(cuid())
  courseId  String  @unique
  /// Nul une fois le compte supprimé.
  passagerId String?
  /// Position du téléphone au moment de l'alerte, si le passager l'a autorisée.
  latitude  Float?
  longitude Float?
  /// Le ticket CRITIQUE ouvert pour l'équipe (traité depuis le support ZupDrive).
  ticketNumber      String?
  equipePrevenueLe  DateTime?
  contactPrevenuLe  DateTime?

  course  CourseDrive @relation(fields: [courseId], references: [id], onDelete: Cascade)
  passager User?      @relation(fields: [passagerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passagerId])
}

/// Un message du chat entre le passager et son chauffeur, pendant une course.
/// Texte court, jamais journalisé. Supprimé avec la course (cascade), à l'effacement
/// du passager, et purgé avec l'historique des courses terminées (retention.service).
model MessageCourseDrive {
  id       String @id @default(cuid())
  courseId String
  /// PASSAGER ou CHAUFFEUR.
  auteur   String
  texte    String
  /// Clé envoyée par l'application : rejouer l'envoi rend le même message.
  cleIdempotence String

  course CourseDrive @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([courseId, auteur, cleIdempotence])
  @@index([courseId, createdAt])
}

// ============================================================================
// ZUPDRIVE — PAIEMENTS ET REVERSEMENTS
// ============================================================================

/// Un paiement de passager pour une course ZupDrive.
/// La course est figée à la commande avec un prix. Stripe charge le passager.
/// Le webhook Stripe confirme le paiement et déverrouille les revenus (fees pour
/// la plateforme, remainingAmount pour le chauffeur).
model PaymentIntentDrive {
  id             String   @id @default(cuid())
  courseId       String   @unique
  passagerId     String?
  /// L'identifiant Stripe du PaymentIntent (pi_...).
  stripeId       String   @unique
  /// Montant en centimes d'euros.
  amountCentimes Int
  /// EUR
  currency       String   @default("EUR")
  /// REQUIRES_PAYMENT_METHOD, REQUIRES_CONFIRMATION, REQUIRES_ACTION, PROCESSING, SUCCEEDED, CANCELED
  status         String   @default("REQUIRES_PAYMENT_METHOD")
  /// Le motif d'annulation, le cas échéant.
  cancellationReason String?
  /// Code de l'échec rapporté par Stripe (payment_intent.payment_failed),
  /// p. ex. card_declined. Nul tant qu'aucun échec n'a été enregistré.
  failureReason String?

  // Revenus figés à l'acceptation (avant charge Stripe, mais connus)
  /// Commission plateforme en centimes.
  platformCommissionCentimes Int
  /// Revenu net du chauffeur en centimes.
  driverEarningsCentimes     Int

  /// Confirmation Stripe arrivée.
  confirmedAt DateTime?

  course  CourseDrive   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  passager User?        @relation(fields: [passagerId], references: [id], onDelete: SetNull)
  payout  DriverPayoutDrive?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passagerId])
  @@index([status])
  @@index([confirmedAt])
}

/// Un versement à un chauffeur ZupDrive, lié à une course payée.
/// Le paiement est figé à l'acceptation ; le versement regroupe plusieurs
/// courses et est traité en lot SEPA hebdomadaire (lundi).
model DriverPayoutDrive {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  chauffeurId     String
  /// Le lot auquel ce versement appartient.
  batchId         String?

  /// Montant net du chauffeur en centimes (après commission plateforme).
  amountCentimes  Int
  /// EUR
  currency        String   @default("EUR")
  /// PENDING, PROCESSED, FAILED, CANCELLED
  status          String   @default("PENDING")

  /// La période comptable (semaine) : lundi au lundi.
  periodStart     DateTime
  periodEnd       DateTime

  /// L'IBAN du chauffeur au moment du versement (copie pour historique, chiffrée).
  ibanSnapshot    String?

  /// Confirmation Stripe (Payout object id).
  stripePayoutId  String?
  /// Timing de traitement réel.
  processedAt     DateTime?
  failureReason   String?

  payment   PaymentIntentDrive     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chauffeur ChauffeurDrive         @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  batch     DriverPayoutBatchDrive? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chauffeurId, status])
  @@index([batchId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

/// Un lot SEPA hebdomadaire de versements aux chauffeurs ZupDrive.
/// Groupé par défaut le lundi 9h00 (heure Bruxelles). Émis une fois par semaine.
model DriverPayoutBatchDrive {
  id                String   @id @default(cuid())
  /// Semaine : lundi 00:00 → lundi 00:00.
  periodStart       DateTime
  periodEnd         DateTime

  /// Montant total du lot en centimes.
  totalAmountCentimes Int
  /// EUR
  currency          String   @default("EUR")
  /// PENDING, SUBMITTED, SUCCEEDED, FAILED
  status            String   @default("PENDING")

  /// Nombre de versements dans ce lot.
  payoutCount       Int      @default(0)

  /// Stripe Connect: le transfer object ID.
  stripeTransferId  String?

  /// Timing
  createdAt         DateTime @default(now())
  submittedAt       DateTime?
  processedAt       DateTime?
  failureReason     String?

  payouts DriverPayoutDrive[]

  @@index([status])
  @@index([periodStart, periodEnd])
}

/// Carnet de clients d'une boutique : ce que CE commerçant sait de CE client.
/// La fiche `Customer` est globale (partagée entre commerçants) ; notes, blocage
/// et retrait du carnet vivent ici pour qu'un commerçant n'agisse jamais sur les
/// autres. `Customer.notes` et `Customer.status` sont dépréciés (plus écrits).
model StoreCustomer {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  notes      String?
  /// ACTIVE, BLOCKED, INACTIVE
  status     String    @default("ACTIVE")
  /// Retiré du carnet de cette boutique seulement.
  hiddenAt   DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([storeId, customerId])
  @@index([customerId])
}

/// Bail du « leader » des tâches de fond : une seule instance de l'API lance les
/// tâches planifiées (relances, arrêtés, vigie). Voir modules/jobs/leader.service.ts.
model JobLease {
  name      String   @id
  owner     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

/// Effets externes à ne pas perdre (e-mails importants) : écrits en base, puis
/// envoyés par un worker avec relances espacées. Voir modules/jobs/outbox.service.ts.
model OutboxMessage {
  id            String    @id @default(cuid())
  type          String
  payload       Json
  /// Empêche le doublon d'un même effet (ex. même commande, même état).
  dedupeKey     String?   @unique
  /// PENDING, PROCESSING, DONE, FAILED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(8)
  nextAttemptAt DateTime  @default(now())
  /// Un envoi PROCESSING dont le bail est dépassé a perdu son worker : repris.
  lockedUntil   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
}

// ============================================================================
// ZUPDRIVE COMPLIANCE, RATINGS & NOTIFICATIONS (Phases 11-15)
// ============================================================================

/// Rapports de conformité automatisés pour les chauffeurs ZupDrive.
/// Stocke les vérifications des 8 points de contrôle avec score de risque.
model ComplianceReportDrive {
  id                   String   @id @default(cuid())
  chauffeurId          String
  /// LOW, MEDIUM, HIGH, CRITICAL
  riskLevel            String   @default("LOW")
  /// Score global 0-100 combinant intégrité (40%), complétude (30%), stabilité (30%)
  complianceScore      Int      @default(0)
  /// Intégrité documentaire (40%)
  documentIntegrity    Int      @default(0)
  /// Taux de complétude des données (30%)
  completionRate       Int      @default(0)
  /// Stabilité/taux d'annulation (30%)
  stabilityRate        Int      @default(0)
  /// Indicateurs de fraude détectés
  fraudIndicators      Json     @default("[]")
  /// Points de vérification (8-point framework)
  verificationPoints   Json     @default("[]")
  /// Recommandations auto-générées
  autoRecommendations  Json     @default("[]")
  /// Dernier contrôle automatisé
  checkedAt            DateTime @default(now())
  /// Expiration du rapport
  expiresAt            DateTime?

  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chauffeurId])
  @@index([riskLevel])
  @@index([checkedAt])
}

/// Évaluations détaillées des courses ZupDrive.
/// Complète NoteCourseDrive avec évaluations par catégorie.
model RatingCourseDrive {
  id              String   @id @default(cuid())
  courseId        String
  chauffeurId     String
  passengerId     String
  /// Note 1-5 stars
  rating          Int
  /// Commentaire du passager
  comment         String?
  /// Évaluation de la propreté (1-5)
  cleanliness     Int?
  /// Évaluation de la conduite (1-5)
  driving         Int?
  /// Évaluation de la communication (1-5)
  communication   Int?
  /// Évaluation du confort (1-5)
  comfort         Int?
  /// Tags: safe_driving, friendly, clean_car, good_music, quiet
  tags            Json     @default("[]")
  /// Notation anonyme
  anonymous       Boolean  @default(false)

  course    CourseDrive  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  passenger User         @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([chauffeurId])
  @@index([passengerId])
  @@index([createdAt])
}

/// Paramètres globaux de la plateforme ZupDrive.
/// Configuration centralisée pour la commission, les payouts, etc.
model PlatformSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([key])
}

model PlatformSettingsDrive {
  id                   String   @id @default("default")
  /// Commission plateforme (0-100 %)
  commissionPercentage Int      @default(20)
  /// Montant minimum pour un payout en centimes
  minPayoutAmount      Int      @default(1000)
  /// Jour de payout (1-7 = lun-dim)
  payoutDay            Int      @default(1)
  /// Cycle de payout: WEEKLY, BIWEEKLY, MONTHLY
  payoutCycle          String   @default("WEEKLY")
  /// Devise
  currency             String   @default("EUR")
  /// Nom de la plateforme
  platformName         String   @default("ZupDrive")
  /// Email support
  supportEmail         String?
  /// Téléphone support
  supportPhone         String?
  /// Fuseau horaire (ex: Europe/Brussels)
  timezone             String   @default("Europe/Brussels")
  /// Mode maintenance
  maintenanceMode      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Notifications in-app pour les utilisateurs ZupDrive.
/// Stockage persistant des notifications avec priorité et statut de lecture.
model NotificationDrive {
  id          String   @id @default(cuid())
  userId      String
  /// ID du chauffeur si applicable
  chauffeurId String?
  /// Type de notification (COURSE_COMPLETED, PAYOUT_COMPLETED, etc.)
  type        String
  /// Titre
  title       String
  /// Message
  message     String
  /// Priorité: low, medium, high, critical
  priority    String   @default("low")
  /// Données additionnelles
  data        Json?
  /// URL d'action
  actionUrl   String?
  /// Lue ou non
  read        Boolean  @default(false)
  /// Timestamp de lecture
  readAt      DateTime?
  /// Expiration
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
}

/// Audit des actions d'administration
model AuditLog {
  id            String   @id @default(cuid())
  /// Action effectuée
  action        String
  /// ID de l'acteur
  actorId       String
  /// Type d'acteur (ADMIN, SYSTEM, DRIVER, PASSAGER)
  actorType     String
  /// ID de la ressource affectée
  resourceId    String
  /// Type de ressource
  resourceType  String
  /// Ancienne valeur (si applicable)
  oldValue      String?
  /// Nouvelle valeur (si applicable)
  newValue      String?
  /// Raison de l'action
  reason        String?
  /// Adresse IP
  ipAddress     String?
  /// User agent
  userAgent     String?

  createdAt DateTime @default(now())

  @@index([resourceId])
  @@index([resourceType])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

/// Contrôles de conformité pour chauffeurs ZupDrive
model ComplianceCheck {
  id           String    @id @default(cuid())
  /// ID du chauffeur
  chauffeurId  String
  /// Type de contrôle
  type         String
  /// Statut du contrôle
  status       String    @default("PENDING")
  /// Résultats du contrôle
  findings     Json      @default("[]")
  /// Date d'expiration du contrôle
  expiresAt    DateTime
  /// Date de complétude
  completedAt  DateTime?
  /// ID de la personne qui a complété
  completedBy  String?
  /// Notes
  notes        String?

  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chauffeurId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
}

/// Workflow de vérification des documents
model DocumentVerificationWorkflow {
  id              String   @id @default(cuid())
  /// ID du chauffeur
  chauffeurId     String
  /// Type de document
  documentType    String
  /// Statut du document
  status          String   @default("PENDING_UPLOAD")
  /// Date d'upload
  uploadedAt      DateTime?
  /// Date de révision
  reviewedAt      DateTime?
  /// ID de la personne qui a révisé
  reviewedBy      String?
  /// Raison du rejet
  rejectionReason String?
  /// Date de prochaine révision
  nextReviewDate  DateTime?

  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chauffeurId, documentType])
  @@index([chauffeurId])
  @@index([status])
  @@index([nextReviewDate])
}

/// Rapport de conformité globale
model ComplianceReport {
  id                          String   @id @default(cuid())
  /// Type de rapport
  reportType                  String
  /// Date de génération
  generatedAt                 DateTime @default(now())
  /// ID de la personne qui a généré
  generatedBy                 String
  /// Total de chauffeurs
  totalDrivers                Int
  /// Chauffeurs avec documents valides
  driversWithValidDocuments   Int
  /// Chauffeurs avec documents expirant
  driversWithExpiringDocuments Int
  /// Chauffeurs avec infractions
  driversWithInfractions      Int
  /// Chauffeurs avec notes basses
  driversWithLowRating        Int
  /// Taux de conformité
  complianceRate              Float
  /// Score de risque
  riskScore                   Float
  /// Recommandations
  recommendations             Json    @default("[]")

  @@index([reportType])
  @@index([generatedAt])
}

// ============================================================================
// ZUPDRIVE: DRIVER MANAGEMENT & DOCUMENTS
// ============================================================================

model ChauffeurDocument {
  id         String    @id @default(cuid())
  chauffeurId String
  type       String    // PERMIS, ASSURANCE, INSPECTION, IDENTITE
  status     String    @default("EN_ATTENTE") // VALIDE, EXPIREE, EN_ATTENTE
  url        String
  expiresAt  DateTime
  verifiedAt DateTime?
  verifiedBy String?

  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chauffeurId, type])
  @@index([chauffeurId])
  @@index([type])
  @@index([expiresAt])
  @@index([status])
}

model ChauffeurInfraction {
  id          String   @id @default(cuid())
  chauffeurId String
  type        String   // PLAINTE_PASSAGER, ACCIDENT, INFRACTION_CODE_ROUTE, AUTRE
  description String
  severity    String   // BASSE, MOYENNE, HAUTE
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolution  String?

  chauffeur ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  @@index([chauffeurId])
  @@index([type])
  @@index([resolvedAt])
  @@index([severity])
}

// ============================================================================
// ZUPDRIVE: SUPPORT SYSTEM
// ============================================================================

model SupportTicket {
  id           String           @id @default(cuid())
  ticketNumber String           @unique
  category     String
  priority     String           @default("MOYENNE")
  subject      String
  description  String
  status       String           @default("OUVERT")
  reporterId   String
  reporterType String
  assignedTo   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  resolvedAt   DateTime?
  resolution   String?
  messages     SupportMessage[]

  @@index([reporterId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([category])
  @@index([createdAt])
  @@index([ticketNumber])
}

model SupportMessage {
  id            String        @id @default(cuid())
  ticketId      String
  authorId      String
  authorType    String
  message       String
  attachmentUrl String?
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
}

// ============================================================================
// ZUPDRIVE: PLATFORM CONFIGURATION
// ============================================================================

model CommissionConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String
  value       Float    @db.Real
  appliesTo   String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([active])
  @@index([appliesTo])
}

model RegionalConfig {
  id                  String   @id @default(cuid())
  region              String   @unique
  minPrice            Int
  baseSurgeMultiplier Float    @default(1.0) @db.Real
  maxSurgeMultiplier  Float    @default(2.5) @db.Real
  peakHours           String
  peakSurgeMultiplier Float    @default(1.5) @db.Real
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([active])
}

model PricingRule {
  id              String   @id @default(cuid())
  name            String   @unique
  type            String
  basePricePerKm  Int
  basePricePerMin Int
  minPrice        Int
  maxPrice        Int?
  description     String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([active])
  @@index([type])
}

// ============================================================================
// ZUPDRIVE: NOTIFICATIONS
// ============================================================================

model NotificationTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  type      String
  subject   String?
  body      String
  variables String   @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active])
  @@index([type])
}

model NotificationLog {
  id            String    @id @default(cuid())
  /// Un même événement ne produit qu'un envoi : la clé est unique (NULL = pas de dédoublonnage).
  dedupeKey     String?   @unique
  recipientId   String
  recipientType String
  type          String
  templateKey   String
  status        String    @default("PENDING")
  recipient     String
  subject       String?
  body          String
  variables     String    @default("{}")
  errorMessage  String?
  sentAt        DateTime?
  failedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@index([templateKey])
  @@index([type])
}

model NotificationAlert {
  id             String         @id @default(cuid())
  chauffeurId    String
  type           String
  severity       String         @default("INFO")
  title          String
  message        String
  triggerAction  String?
  read           Boolean        @default(false)
  readAt         DateTime?
  createdAt      DateTime       @default(now())
  chauffeur      ChauffeurDrive @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([chauffeurId])
  @@index([read])
  @@index([severity])
  @@index([type])
}

model ScheduledReport {
  id               String    @id @default(cuid())
  name             String
  reportType       String
  frequency        String
  recipients       String    @default("[]")
  format           String    @default("PDF")
  lastGeneratedAt  DateTime?
  nextGenerationAt DateTime
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([reportType])
  @@index([frequency])
  @@index([active])
  @@index([nextGenerationAt])
}

// ============================================================================
// ZUPDRIVE: WEBHOOKS
// ============================================================================

model WebhookEndpoint {
  id          String   @id @default(cuid())
  url         String
  events      String   @default("[]")
  active      Boolean  @default(true)
  secret      String   @unique
  retryPolicy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  deliveries  WebhookDeliveryDrive[]

  @@index([active])
  @@index([url])
}

model WebhookEvent {
  id           String    @id @default(cuid())
  eventType    String
  resourceType String
  resourceId   String
  data         String    @default("{}")
  timestamp    DateTime
  delivered    Boolean   @default(false)
  deliveredAt  DateTime?
  nextRetryAt  DateTime?
  retryCount   Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  deliveries   WebhookDeliveryDrive[]

  @@index([eventType])
  @@index([resourceId])
  @@index([timestamp])
  @@index([delivered])
}

model ProviderIntegration {
  id                String   @id @default(cuid())
  provider          String
  type              String
  apiKey            String
  webhookSigningKey String?
  active            Boolean  @default(true)
  config            String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([provider])
  @@index([active])
  @@index([type])
}

/// Intention financière durable, distincte de l'outbox de notifications.
enum RefundOperationStatus {
  REQUESTED
  PROCESSING
  WAITING_STRIPE
  RETRY
  SUCCEEDED
  ABANDONED
}

model RefundOperation {
  id String @id @default(cuid())
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentIntentId String
  amountCents Int
  currency String
  reason String
  idempotencyKey String @unique
  status RefundOperationStatus @default(REQUESTED)
  stripeRefundId String? @unique
  attempts Int @default(0)
  version Int @default(0)
  firstCallAt DateTime?
  nextAttemptAt DateTime @default(now())
  lockedUntil DateTime?
  lastError String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history RefundOperationEvent[]
  @@index([status, nextAttemptAt])
}

/// Journal conservé ; un worker dont le bail est perdu ne peut plus écrire.
model RefundOperationEvent {
  id String @id @default(cuid())
  operationId String
  operation RefundOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  status RefundOperationStatus
  code String?
  createdAt DateTime @default(now())
  @@index([operationId, createdAt])
}
