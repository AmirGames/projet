// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  emailVerified Boolean   @default(false)
  emailToken    String?   @unique
  emailTokenExpiresAt DateTime?
  isSystemAdmin Boolean   @default(false)
  isSuperOwner  Boolean   @default(false)
  status        String    @default("ACTIVE") // ACTIVE, BANNED, SUSPENDED

  // Relations
  memberships   Membership[]
  auditLogs     SystemAuditLog[]
  driver        Driver?
  ticketMessages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================================================
// ORGANIZATIONS & MULTI-TENANCY
// ============================================================================

enum OrganizationTier {
  FREE
  PREMIUM
  PRO
}

model Organization {
  id       String            @id @default(cuid())
  name     String
  email    String?
  slug     String            @unique
  tier     OrganizationTier  @default(FREE)
  plan     String            @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE
  status   String            @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED, INACTIVE

  // Suspension info
  suspensionReason    String?
  suspensionDate      DateTime?

  // Closure info
  closureReason       String?
  closureDate         DateTime?
  closedUntil         DateTime?   // Auto-suppression le jour X (60j après fermeture)

  // Archive info
  archiveBackupId     String?     // ID du backup MerchantArchive
  isArchivedPermanently Boolean   @default(false)

  // Relations
  stores              Store[]
  memberships         Membership[]
  tickets             MerchantTicket[]
  commissionHistory   CommissionHistory[]
  archive             MerchantArchive?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([closedUntil])
}

enum MembershipRole {
  ADMIN
  STORE_MANAGER
  STORE_STAFF
}

model Membership {
  id      String         @id @default(cuid())
  userId  String
  orgId   String
  role    MembershipRole
  storeIds String[]      @default([]) // JSON array of store IDs this user can access

  // Relations
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

// ============================================================================
// SYSTEM ADMINISTRATION
// ============================================================================

model SystemConfig {
  id                  String    @id @default(cuid())
  platformFeePercent  Decimal   @default(5.0) @db.Decimal(5, 2)
  minOrderAmount      Decimal   @default(0) @db.Decimal(10, 2)
  maxOrderAmount      Decimal   @default(9999.99) @db.Decimal(10, 2)
  maintenanceMode     Boolean   @default(false)
  maintenanceMessage  String?
  selectedTheme       String    @default("dark")

  // Settings JSON for additional configurations
  settings            Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MerchantTicket {
  id              String    @id @default(cuid())
  orgId           String
  title           String
  description     String
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  category        String    // TECHNICAL, BILLING, ACCOUNT, OTHER

  // Archivage (uniquement pour les tickets fermés)
  archivedAt      DateTime?

  // Relations
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?

  @@index([orgId])
  @@index([status])
  @@index([createdAt])
  @@index([archivedAt])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String
  authorName  String
  // MERCHANT ou ADMIN : détermine le côté affiché dans la conversation
  authorRole  String
  body        String

  // Relations
  ticket      MerchantTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model CommissionHistory {
  id              String    @id @default(cuid())
  orgId           String
  amount          Decimal   @db.Decimal(10, 2)
  percentage      Decimal   @db.Decimal(5, 2)
  period          String    // Monthly period like "2024-01"
  ordersCount     Int
  totalRevenue    Decimal   @db.Decimal(10, 2)

  // Relations
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([period])
}

model SystemAuditLog {
  id              String    @id @default(cuid())
  adminId         String
  action          String
  target          String    // Which merchant or system component
  changes         Json?     // What changed

  // Relations
  admin           User      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ============================================================================
// MERCHANT ARCHIVE & CLOSURE
// ============================================================================

model MerchantArchive {
  id                      String    @id @default(cuid())
  organizationId          String    @unique

  // Backup data (complete snapshot)
  organizationData        Json      // Entire Organization object
  storesData              Json?     // Array of Store objects
  productsData            Json?     // Array of Product objects
  ordersData              Json?     // Array of Order objects
  customersData           Json?     // Array of Customer objects

  // Archive metadata
  reason                  String    // Why archived (closure reason)
  closureDate             DateTime
  restorationDeadline     DateTime  // After this date, no restore possible

  // Status
  isRestored              Boolean   @default(false)
  restoredAt              DateTime?
  restoredByAdminId       String?

  // Relations
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt               DateTime  @default(now())

  @@index([organizationId])
  @@index([closureDate])
  @@index([restorationDeadline])
}

// ============================================================================
// STORES (ESTABLISHMENTS)
// ============================================================================

model Store {
  id            String    @id @default(cuid())
  orgId         String
  name          String
  slug          String
  address       String?
  city          String?
  postalCode    String?
  phone         String?
  email         String?
  description   String?

  // GÉOLOCALISATION - Pour Uber Eats like
  latitude      Float?    // Pour trouver restaurants proches
  longitude     Float?

  // Store settings (JSON)
  settings      Json      @default("{}")

  // Operating hours (JSON object by day of week)
  // Example: { "MON": { "open": "09:00", "close": "22:00", "closed": false }, ... }
  operatingHours Json     @default("{}")

  // Pickup slots (JSON array)
  // Example: [{ start: "11:00", end: "13:00", maxOrders: 10 }, ...]
  pickupSlots   Json      @default("[]")

  // Quick store status
  isOpen        Boolean   @default(true)

  // Delivery options
  acceptsDelivery Boolean @default(true)   // Accept delivery orders
  acceptsPickup   Boolean @default(true)   // Accept pickup orders
  deliveryCost    Decimal @default(0) @db.Decimal(10, 2)
  minDeliveryAmount Decimal @default(0) @db.Decimal(10, 2)

  // Rating
  rating        Decimal   @default(5.0) @db.Decimal(3, 2)
  totalRatings  Int       @default(0)

  // Soft delete
  deletedAt     DateTime?

  // Relations
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products      Product[]
  categories    Category[]
  orders        Order[]
  theme         Theme? @relation("ThemeToStore")
  deliveryZones DeliveryZone[]
  promotions    Promotion[]
  staff         Staff[]
  reviews       Review[] @relation("ReviewToStore")
  campaigns     MarketingCampaign[] @relation("CampaignToStore")
  taxSettings   TaxSetting[] @relation("TaxSettingToStore")
  paymentMethods PaymentMethod[] @relation("PaymentMethodToStore")
  notifications Notification[] @relation("NotificationToStore")
  tags          ProductTag[] @relation("TagToStore")
  favorites     FavoriteStore[] @relation("StoreFavorites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([deletedAt])
}

// ============================================================================
// PRODUCTS & CATALOG
// ============================================================================

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  sku         String
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  categoryId  String?
  stock       Int           @default(0)
  lowStockThreshold Int     @default(10)
  displayOrder Int          @default(0)
  status      ProductStatus @default(DRAFT)

  // Soft delete
  deletedAt   DateTime?

  // Relations
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  reviews     Review[] @relation("ReviewToProduct")
  media       ProductMedia[] @relation("MediaToProduct")
  seo         ProductSeo? @relation("SeoToProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  order     Int     @default(0)

  // Relations
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([order])
}

model Category {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  displayOrder Int    @default(0)

  // Relations
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

model ProductOption {
  id          String  @id @default(cuid())
  productId   String
  name        String  // "Taille", "Extra topping"
  // choices is JSON array: ["S", "M", "L"]
  choices     Json    @default("[]")
  isRequired  Boolean @default(false)
  pricingType String  @default("none") // "none" | "fixed" | "percentage"

  // Relations
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  sku         String
  // combination is JSON: { optionId: choiceId }
  combination Json
  price       Decimal? @db.Decimal(10, 2)
  stock       Int     @default(0)

  // Relations
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

// ============================================================================
// ORDERS
// ============================================================================

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  READY
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

model Order {
  id              String       @id @default(cuid())
  storeId         String
  customerId      String?      // nullable for guest checkout

  // Items
  items           OrderItem[]

  // Customer contact
  customerName    String
  customerEmail   String
  customerPhone   String

  // Delivery info
  deliveryType    DeliveryType
  pickupTime      DateTime?    // if PICKUP
  deliveryAddress String?      // if DELIVERY
  deliveryCity    String?
  deliveryPostal  String?

  // Status
  status          OrderStatus  @default(PENDING)

  // Payment
  totalAmount     Decimal      @db.Decimal(10, 2)
  taxAmount       Decimal      @db.Decimal(10, 2)
  feesAmount      Decimal      @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?      // Stripe payment intent ID

  notes           String?

  // Soft delete
  deletedAt       DateTime?

  // Relations
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments        Payment[]
  delivery        OrderDelivery?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  // selectedOptions is JSON: { optionId: choiceId }
  selectedOptions Json    @default("{}")
  price           Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  // Relations
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id              String       @id @default(cuid())
  orderId         String
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("EUR")
  status          PaymentStatus @default(PENDING)
  
  // Stripe info
  stripePaymentIntentId String?
  stripeClientSecret String?
  stripeStatus    String?      // requires_payment_method, succeeded, etc.
  
  paidAt          DateTime?

  // Relations
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId])
  @@index([stripePaymentIntentId])
}

// ============================================================================
// THEME & CUSTOMIZATION
// ============================================================================

model Theme {
  id      String  @id @default(cuid())
  storeId String  @unique
  
  // Design tokens (JSON)
  // {
  //   "colors": { "primary": "#FF0000", "secondary": "..." },
  //   "fonts": { "body": "Inter", "heading": "Poppins" }
  // }
  config  Json    @default("{}")
  
  // CSS (future: MVP uses only colors + fonts)
  customCss String?
  
  status  String  @default("draft") // draft | published

  // Relations
  store   Store   @relation("ThemeToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// DELIVERY & DRIVERS
// ============================================================================

model Driver {
  id              String    @id @default(cuid())
  userId          String?   @unique // Link to User account (optional)
  name            String
  email           String    @unique
  phone           String
  vehicleType     String    // car, scooter, bike
  vehiclePlate    String?
  licensePlate    String?   // Alias for vehiclePlate

  // Location
  latitude        Float?
  longitude       Float?
  lastLocationUpdate DateTime?

  // Status
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, OFFLINE
  isOnline        Boolean   @default(false)
  isAvailable     Boolean   @default(true)
  currentOrderId  String?   // Current delivery

  // Ratings
  rating          Decimal   @default(5.0) @db.Decimal(3, 2)
  totalRatings    Int       @default(0)

  // Financial
  totalEarnings   Decimal   @default(0) @db.Decimal(10, 2)
  totalDeliveries Int       @default(0)

  // Relations
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries      OrderDelivery[]
  documents       DriverDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isOnline])
  @@index([userId])
}

model DriverDocument {
  id              String    @id @default(cuid())
  driverId        String
  type            String    // license, insurance, vehicle_registration
  documentUrl     String
  expiryDate      DateTime?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED

  // Relations
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([status])
}

model OrderDelivery {
  id              String    @id @default(cuid())
  orderId         String    @unique
  driverId        String?

  // Delivery details
  pickupTime      DateTime?
  deliveryTime    DateTime?
  estimatedTime   DateTime?
  actualTime      DateTime?

  // Location tracking
  pickupLat       Float?
  pickupLng       Float?
  deliveryLat     Float?
  deliveryLng     Float?

  // Status
  status          String    @default("PENDING") // PENDING, ACCEPTED, PICKED_UP, DELIVERED, FAILED

  // Proof
  proofPhoto      String?   // Photo de livraison

  // Relations
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver          Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([driverId])
  @@index([status])
}

// ============================================================================
// DELIVERY ZONES
// ============================================================================

model DeliveryZone {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  
  // Polygon GeoJSON (simple for MVP: just center + radius or boundaries)
  // Example: { type: "Point", coordinates: [lat, lon] }
  polygon   Json?
  
  baseFee   Decimal @db.Decimal(10, 2)
  minOrder  Decimal @db.Decimal(10, 2)

  // Relations
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// ============================================================================
// PROMOTIONS
// ============================================================================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id          String          @id @default(cuid())
  storeId     String
  code        String
  description String?
  type        PromotionType
  discountType String         @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  discountValue Decimal       @db.Decimal(10, 2)

  // Scope: which products/categories apply to
  applicableToAll Boolean      @default(true)
  productIds  String[]        @default([])
  categoryIds String[]        @default([])

  // Validity
  startDate   DateTime?
  endDate     DateTime?
  expiresAt   DateTime?
  isActive    Boolean         @default(true)

  // Limits
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxUses     Int?            // null = unlimited
  maxUsesPerCustomer Int?
  currentUses Int             @default(0)
  timesUsed   Int             @default(0)

  status      String          @default("ACTIVE") // ACTIVE, INACTIVE, EXPIRED

  // Relations
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
  @@index([status])
}

// ============================================================================
// STAFF MANAGEMENT
// ============================================================================

enum StaffRole {
  MANAGER
  CASHIER
  KITCHEN
  DELIVERY
  SUPPORT
}

model Staff {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  email       String
  phone       String?
  role        StaffRole @default(CASHIER)
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED

  // Optional: link to user account if staff has login
  userId      String?

  // Permissions (JSON array of action strings)
  permissions Json      @default("[]")

  // Relations
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
  @@index([status])
}

// ============================================================================
// FAVORITES & PREFERENCES
// ============================================================================

model FavoriteStore {
  id        String  @id @default(cuid())
  customerId String
  storeId   String

  // Relations
  customer  Customer @relation("CustomerFavorites", fields: [customerId], references: [id], onDelete: Cascade)
  store     Store   @relation("StoreFavorites", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, storeId])
  @@index([customerId])
  @@index([storeId])
}

// ============================================================================
// CUSTOMERS (GLOBAL - SHARED ACROSS ALL STORES)
// ============================================================================

model Customer {
  id              String    @id @default(cuid())
  // GLOBAL CLIENT - peut commander chez tous les restaurants
  name            String
  email           String    @unique
  phone           String?
  address         String?
  city            String?
  postalCode      String?
  latitude        Float?    // Géolocalisation optionnelle
  longitude       Float?

  // Customer info
  totalOrders     Int       @default(0)
  totalSpent      Decimal   @default(0) @db.Decimal(10, 2)
  lastOrderDate   DateTime?

  // Notes (internal)
  notes           String?

  // Status
  status          String    @default("ACTIVE") // ACTIVE, BLOCKED, INACTIVE

  // Soft delete
  deletedAt       DateTime?

  // Relations
  orders          Order[]
  reviews         Review[] @relation("ReviewToCustomer")
  favorites       FavoriteStore[] @relation("CustomerFavorites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

// ============================================================================
// REVIEWS & RATINGS
// ============================================================================

model Review {
  id          String  @id @default(cuid())
  storeId     String
  productId   String
  customerId  String?

  rating      Int     @default(5) // 1-5 stars
  comment     String?
  helpfulCount Int    @default(0)

  status      String  @default("PENDING") // PENDING, APPROVED, REJECTED

  // Relations
  store       Store   @relation("ReviewToStore", fields: [storeId], references: [id], onDelete: Cascade)
  product     Product @relation("ReviewToProduct", fields: [productId], references: [id], onDelete: Cascade)
  customer    Customer? @relation("ReviewToCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// MARKETING CAMPAIGNS
// ============================================================================

enum CampaignType {
  EMAIL
  SMS
  PUSH
  INAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model MarketingCampaign {
  id              String        @id @default(cuid())
  storeId         String

  name            String
  description     String?
  type            CampaignType
  message         String

  // Target audience
  targetAudience  String        @default("all") // all, new, returning, inactive

  // Scheduling
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  // Statistics
  sentCount       Int           @default(0)
  openCount       Int           @default(0)
  clickCount      Int           @default(0)
  conversionCount Int           @default(0)

  // Relations
  store           Store         @relation("CampaignToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// TAX SETTINGS
// ============================================================================

model TaxSetting {
  id              String  @id @default(cuid())
  storeId         String

  name            String  // "VAT 20%", "TVA"
  rate            Decimal @db.Decimal(5, 2) // 20.00 for 20%

  // Scope
  applicableTo    String  @default("all") // all, categories, products
  categoryIds     String[] @default([])
  productIds      String[] @default([])

  // Status
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE

  // Relations
  store           Store   @relation("TaxSettingToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([status])
}

// ============================================================================
// PAYMENT METHODS
// ============================================================================

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  STRIPE
  BANK_TRANSFER
  CASH
  APPLE_PAY
  GOOGLE_PAY
}

model PaymentMethod {
  id              String          @id @default(cuid())
  storeId         String
  userId          String?         // For customer payment methods

  type            PaymentMethodType
  name            String          // "Stripe Card", "PayPal"

  // Stripe specific
  stripePaymentMethodId String?   @unique
  stripeCustomerId String?

  // Configuration (JSON)
  // For Stripe: { apiKey, secretKey, webhookSecret }
  // For PayPal: { clientId, clientSecret }
  // For Bank: { accountNumber, routingNumber, bankName }
  config          Json            @default("{}")

  // Status
  isDefault       Boolean         @default(false)
  isActive        Boolean         @default(true)

  // Commission/fees
  commissionPercent Decimal       @default(0) @db.Decimal(5, 2)
  fixedFee        Decimal         @default(0) @db.Decimal(10, 2)

  // Relations
  store           Store           @relation("PaymentMethodToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([isActive])
  @@index([userId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  ORDER_PLACED
  ORDER_DELIVERED
  PROMOTION_AVAILABLE
  STOCK_LOW
  REVIEW_RECEIVED
  PAYMENT_FAILED
  PAYMENT_SUCCEEDED
  TICKET_MESSAGE
}

model Notification {
  id              String            @id @default(cuid())
  // Optionnel : une notification de ticket ne dépend d'aucune boutique
  storeId         String?

  type            NotificationType
  title           String
  message         String
  recipientEmail  String

  // Lien profond ouvert au clic sur la notification
  link            String?

  // Status
  isRead          Boolean           @default(false)
  sentAt          DateTime?
  readAt          DateTime?

  // Metadata
  relatedOrderId  String?
  relatedProductId String?

  // Relations
  store           Store?            @relation("NotificationToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// PRODUCT VARIANTS & MEDIA
// ============================================================================

model ProductMedia {
  id              String  @id @default(cuid())
  productId       String

  url             String
  alt             String?
  type            String  @default("image") // image, video
  displayOrder    Int     @default(0)

  // Relations
  product         Product @relation("MediaToProduct", fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([displayOrder])
}

// ============================================================================
// PRODUCT SEO & TAGS
// ============================================================================

model ProductSeo {
  id              String  @id @default(cuid())
  productId       String  @unique

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  slug            String
  ogImage         String?
  ogDescription   String?

  // Relations
  product         Product @relation("SeoToProduct", fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@unique([slug])
}

model ProductTag {
  id              String  @id @default(cuid())
  storeId         String

  name            String
  slug            String
  description     String?
  color           String? // Hex color for UI

  // Product association (JSON array of product IDs)
  productIds      String[] @default([])

  // Relations
  store           Store   @relation("TagToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

// ============================================================================
// PLATEFORME : CLÉS API, WEBHOOKS, SAUVEGARDES, SÉCURITÉ
// ============================================================================

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  // Début lisible de la clé (ex. sk_live_a1b2c3) : la clé complète n'est
  // affichée qu'une fois, seul son hachage est conservé.
  prefix      String
  keyHash     String    @unique
  status      String    @default("ACTIVE") // ACTIVE, REVOKED
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?

  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([prefix])
}

model Webhook {
  id            String    @id @default(cuid())
  url           String
  events        String[]  @default([])
  // Sert à signer chaque envoi pour que le destinataire puisse le vérifier.
  secret        String
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, FAILED
  lastTriggered DateTime?
  retryCount    Int       @default(0)
  createdById   String?

  deliveries    WebhookDelivery[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  success    Boolean  @default(false)
  error      String?

  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([webhookId])
  @@index([createdAt])
}

model Backup {
  id          String    @id @default(cuid())
  name        String
  sizeBytes   Int       @default(0)
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  filePath    String?
  error       String?
  createdById String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
  @@index([status])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  action    String   // LOGIN_FAILED, LOGIN_SUCCESS, ADMIN_GRANTED...
  actor     String   // email concerné, ou "anonyme"
  target    String   @default("")
  severity  String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status    String   @default("SUCCESS") // SUCCESS, FAILED, WARNING
  details   String   @default("")
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity])
  @@index([action])
}
