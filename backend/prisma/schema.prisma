// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  emailVerified Boolean   @default(false)
  // Empreintes, jamais les jetons eux-mêmes : une lecture de la base ne doit
  // pas suffire à confirmer une adresse ni à s'emparer d'un compte.
  emailTokenHash String?  @unique
  emailTokenExpiresAt DateTime?
  resetTokenHash String?  @unique
  resetTokenExpiresAt DateTime?
  isSystemAdmin Boolean   @default(false)
  isSuperOwner  Boolean   @default(false)
  status        String    @default("ACTIVE") // ACTIVE, BANNED, SUSPENDED

  // Relations
  memberships   Membership[]
  auditLogs     SystemAuditLog[]
  driver        Driver?
  customer      Customer?  // REFONTE IDENTITÉ UNIFIÉE: Relation inverse
  ticketMessages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================================================
// ORGANIZATIONS & MULTI-TENANCY
// ============================================================================

enum OrganizationTier {
  FREE
  PREMIUM
  PRO
}

// Le contenu d'une formule — son nom, son prix, ce qu'elle autorise.
//
// Les trois codes restent fixes : ils servent de clé à Organization.tier. Ce
// qui se vend derrière, en revanche, se règle depuis l'espace plateforme :
// écrit en dur, il fallait modifier le code pour changer un tarif.
model PlanTier {
  code         OrganizationTier @id
  label        String
  maxStores    Int
  monthlyPrice Decimal          @default(0) @db.Decimal(10, 2)
  /// La commission prélevée sur les ventes, en pourcentage. Elle n'existait
  /// qu'en réglage global : toutes les formules payaient le même taux, et rien
  /// ne permettait de faire payer moins cher un abonnement plus élevé.
  commissionPercent Decimal      @default(5) @db.Decimal(5, 2)
  // Arguments de vente, une phrase par ligne.
  features     Json             @default("[]")
  // L'ordre de la grille, et donc la formule proposée à la suivante.
  displayOrder Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id       String            @id @default(cuid())
  name     String
  email    String?
  slug     String            @unique
  tier     OrganizationTier  @default(FREE)
  plan     String            @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE
  status   String            @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED, INACTIVE

  // Suspension info
  suspensionReason    String?
  suspensionDate      DateTime?

  // Closure info
  closureReason       String?
  closureDate         DateTime?
  closedUntil         DateTime?   // Auto-suppression le jour X (60j après fermeture)

  // Archive info
  archiveBackupId     String?     // ID du backup MerchantArchive
  isArchivedPermanently Boolean   @default(false)

  /// L'identité de facturation du commerce.
  ///
  /// La plateforme lui facture une commission et lui doit des versements, sans
  /// rien savoir de lui : ni raison sociale, ni adresse de facturation, ni
  /// numéro de TVA, ni compte où virer. Une facture sans ces mentions n'en est
  /// pas une.
  legalName           String?
  vatNumber           String?
  registrationNumber  String?     // SIRET en France, BCE en Belgique
  billingAddress      String?
  billingPostalCode   String?
  billingCity         String?
  billingCountry      String?     @default("France")

  /// Le propriétaire du commerce, la personne physique derrière la société.
  ownerFirstName      String?
  ownerLastName       String?
  ownerEmail          String?
  ownerPhone          String?
  ownerBirthDate      DateTime?

  /// Le compte à créditer.
  ///
  /// L'IBAN n'est jamais rendu en entier : les écrans n'en montrent que les
  /// quatre derniers caractères, assez pour reconnaître son compte, pas assez
  /// pour s'en servir ailleurs.
  iban                String?
  bic                 String?
  accountHolder       String?

  // Relations
  stores              Store[]
  memberships         Membership[]
  tickets             MerchantTicket[]
  commissionHistory   CommissionHistory[]
  archive             MerchantArchive?
  documents           OrganizationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([closedUntil])
}

/// Une pièce justificative du commerçant : Kbis, statuts, pièce d'identité.
///
/// La plateforme n'avait aucun moyen de lui demander un justificatif, ni lui de
/// le fournir : tout se serait échangé par courriel, hors du service.
model OrganizationDocument {
  id          String    @id @default(cuid())
  orgId       String
  type        String    // registration, identity, vat, bank, other
  /// Le document lui-même. L'hébergement de fichiers n'étant pas branché, le
  /// commerçant fournit un lien ; le jour où un stockage existera, c'est ce
  /// champ qui le recevra.
  documentUrl String
  fileName    String?
  expiryDate  DateTime?
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  /// Le motif d'un refus, que le commerçant doit pouvoir lire.
  reviewNote  String?
  reviewedAt  DateTime?

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([status])
}

enum MembershipRole {
  ADMIN
  STORE_MANAGER
  STORE_STAFF
}

model Membership {
  id      String         @id @default(cuid())
  userId  String
  orgId   String
  role    MembershipRole
  storeIds String[]      @default([]) // JSON array of store IDs this user can access

  // Relations
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

// ============================================================================
// SYSTEM ADMINISTRATION
// ============================================================================

model SystemConfig {
  id                  String    @id @default(cuid())
  platformFeePercent  Decimal   @default(5.0) @db.Decimal(5, 2)
  minOrderAmount      Decimal   @default(0) @db.Decimal(10, 2)
  maxOrderAmount      Decimal   @default(9999.99) @db.Decimal(10, 2)
  maintenanceMode     Boolean   @default(false)
  maintenanceMessage  String?
  selectedTheme       String    @default("dark")

  // Rémunération des livreurs et attribution des courses
  driverBaseFee       Decimal   @default(2.50) @db.Decimal(10, 2)
  driverPerKmFee      Decimal   @default(0.80) @db.Decimal(10, 2)
  // Délai laissé au livreur pour accepter avant de passer au suivant
  driverOfferSeconds  Int       @default(30)
  // Au-delà, on ne propose plus la course
  driverMaxRadiusKm   Float     @default(8)

  // Settings JSON for additional configurations
  settings            Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MerchantTicket {
  id              String    @id @default(cuid())
  orgId           String
  title           String
  description     String
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  category        String    // TECHNICAL, BILLING, ACCOUNT, OTHER

  // Archivage (uniquement pour les tickets fermés)
  archivedAt      DateTime?

  // Relations
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?

  @@index([orgId])
  @@index([status])
  @@index([createdAt])
  @@index([archivedAt])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String
  authorName  String
  // MERCHANT ou ADMIN : détermine le côté affiché dans la conversation
  authorRole  String
  body        String

  // Relations
  ticket      MerchantTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model CommissionHistory {
  id              String    @id @default(cuid())
  orgId           String
  amount          Decimal   @db.Decimal(10, 2)
  percentage      Decimal   @db.Decimal(5, 2)
  period          String    // Monthly period like "2024-01"
  ordersCount     Int
  totalRevenue    Decimal   @db.Decimal(10, 2)

  // Relations
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([period])
}

model SystemAuditLog {
  id              String    @id @default(cuid())
  adminId         String
  action          String
  target          String    // Which merchant or system component
  changes         Json?     // What changed

  /// D'où l'action a été faite. La table ne gardait rien : le journal affichait
  /// une section « Informations réseau » vide, ce qui la rendait inutile pour
  /// distinguer deux administrateurs ou repérer un accès inhabituel.
  ipAddress       String?
  userAgent       String?

  // Relations
  admin           User      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ============================================================================
// MERCHANT ARCHIVE & CLOSURE
// ============================================================================

model MerchantArchive {
  id                      String    @id @default(cuid())
  organizationId          String    @unique

  // Backup data (complete snapshot)
  organizationData        Json      // Entire Organization object
  storesData              Json?     // Array of Store objects
  productsData            Json?     // Array of Product objects
  ordersData              Json?     // Array of Order objects
  customersData           Json?     // Array of Customer objects

  // Archive metadata
  reason                  String    // Why archived (closure reason)
  closureDate             DateTime
  restorationDeadline     DateTime  // After this date, no restore possible

  // Status
  isRestored              Boolean   @default(false)
  restoredAt              DateTime?
  restoredByAdminId       String?

  // Relations
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt               DateTime  @default(now())

  @@index([organizationId])
  @@index([closureDate])
  @@index([restorationDeadline])
}

// ============================================================================
// STORES (ESTABLISHMENTS)
// ============================================================================

model Store {
  id            String    @id @default(cuid())
  orgId         String
  name          String
  slug          String
  address       String?
  city          String?
  postalCode    String?
  phone         String?
  email         String?
  description   String?

  /// Ce que vend ce commerce, et ce qu'on y mange.
  ///
  /// L'inscription ne le demandait pas : toute boutique était un « restaurant »
  /// sans genre, et le client ne pouvait ni filtrer par type de commerce ni
  /// chercher une pizzeria.
  businessType  String?   // restaurant, grocery, supermarket, deli, liquor, florist, pharmacy, shop
  cuisineType   String?   // pizza, japanese-sushi, burgers… sans objet hors restauration

  /// L'identité de facturation propre à cette boutique.
  ///
  /// Vide, c'est celle de l'organisation qui s'applique — le cas courant :
  /// plusieurs points de vente sous une même société. Renseignée, elle prime :
  /// trois commerces peuvent relever de trois sociétés, donc de trois numéros
  /// de TVA.
  legalName          String?
  vatNumber          String?
  registrationNumber String?

  // GÉOLOCALISATION - Pour Uber Eats like
  latitude      Float?    // Pour trouver restaurants proches
  longitude     Float?

  // Store settings (JSON)
  settings      Json      @default("{}")

  /// Horaires par jour, en plusieurs plages : un service le midi, un autre le
  /// soir. Une fermeture antérieure à l'ouverture se termine le lendemain.
  /// { "MON": { "closed": false, "plages": [{ "open": "11:30", "close": "14:00" },
  ///                                        { "open": "17:30", "close": "01:00" }] } }
  /// L'ancienne forme { open, close, closed } reste lue.
  operatingHours Json     @default("{}")

  // Pickup slots (JSON array)
  // Example: [{ start: "11:00", end: "13:00", maxOrders: 10 }, ...]
  pickupSlots   Json      @default("[]")

  // Quick store status
  isOpen        Boolean   @default(true)

  // Delivery options
  acceptsDelivery Boolean @default(true)   // Accept delivery orders
  acceptsPickup   Boolean @default(true)   // Accept pickup orders
  deliveryCost    Decimal @default(0) @db.Decimal(10, 2)
  minDeliveryAmount Decimal @default(0) @db.Decimal(10, 2)

  // Rating
  rating        Decimal   @default(5.0) @db.Decimal(3, 2)
  totalRatings  Int       @default(0)

  // Soft delete
  deletedAt     DateTime?

  // Relations
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products      Product[]
  categories    Category[]
  orders        Order[]
  theme         Theme? @relation("ThemeToStore")
  deliveryZones DeliveryZone[]
  promotions    Promotion[]
  staff         Staff[]
  reviews       Review[] @relation("ReviewToStore")
  campaigns     MarketingCampaign[] @relation("CampaignToStore")
  taxSettings   TaxSetting[] @relation("TaxSettingToStore")
  invoiceSeqs   InvoiceSeq[] @relation("InvoiceSeqToStore")
  invoices      Invoice[]    @relation("InvoiceToStore")
  paymentMethods PaymentMethod[] @relation("PaymentMethodToStore")
  notifications Notification[] @relation("NotificationToStore")
  tags          ProductTag[] @relation("TagToStore")
  favorites     FavoriteStore[] @relation("StoreFavorites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([deletedAt])
}

// ============================================================================
// PRODUCTS & CATALOG
// ============================================================================

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  sku         String
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  categoryId  String?
  stock       Int           @default(0)
  lowStockThreshold Int     @default(10)
  // Disponibilité du jour, gérée à la main par le commerçant. Le suivi
  // chiffré du stock viendra plus tard, par ingrédients et recettes.
  isAvailable Boolean       @default(true)
  displayOrder Int          @default(0)
  status      ProductStatus @default(DRAFT)

  // La question posée au client quand le plat se décline : « Type de pâtes »,
  // « Taille ». Vide, le plat n'a qu'une forme.
  variantLabel String?

  // Soft delete
  deletedAt   DateTime?

  // Relations
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  reviews     Review[] @relation("ReviewToProduct")
  media       ProductMedia[] @relation("MediaToProduct")
  seo         ProductSeo? @relation("SeoToProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  order     Int     @default(0)

  // Relations
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([order])
}

enum CategorySortMode {
  MANUAL
  ALPHA_ASC
  ALPHA_DESC
  PRICE_ASC
  PRICE_DESC
}

model Category {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  displayOrder Int    @default(0)

  /// Comment les produits de cette catégorie s'affichent : dans l'ordre que
  /// le commerçant a fixé au glisser-déposer (MANUAL, la valeur par défaut,
  /// qui ne change rien pour les catégories existantes), ou recalculés à la
  /// volée par nom ou par prix. S'applique à la fois au tableau de bord du
  /// commerçant et à la vitrine du client — les deux doivent montrer le même
  /// ordre.
  sortMode    CategorySortMode @default(MANUAL)

  // Relations
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

model ProductOption {
  id          String  @id @default(cuid())
  productId   String
  name        String  // "Taille", "Extra topping"
  // choices is JSON array: ["S", "M", "L"]
  choices     Json    @default("[]")
  isRequired  Boolean @default(false)
  pricingType String  @default("none") // "none" | "fixed" | "percentage"

  // Relations
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  sku         String
  // Ce que lit le client : « Penne », « Spaghetti », « Tagliatelle ». Sans
  // libellé propre, une commande ne pouvait nommer que le plat parent.
  label       String  @default("")
  // L'ordre voulu par le commerçant, comme pour les produits.
  displayOrder Int    @default(0)
  // combination is JSON: { optionId: choiceId }
  combination Json    @default("{}")
  // Vide, la variante est au prix du plat : une déclinaison ne coûte pas
  // toujours plus cher.
  price       Decimal? @db.Decimal(10, 2)
  stock       Int     @default(0)
  isAvailable Boolean @default(true)

  // Relations
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

// ============================================================================
// ORDERS
// ============================================================================

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  REJECTED
  READY
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

model Order {
  id              String       @id @default(cuid())
  storeId         String
  customerId      String?      // nullable for guest checkout

  // Items
  items           OrderItem[]

  // Customer contact
  customerName    String
  customerEmail   String
  customerPhone   String

  // Delivery info
  deliveryType    DeliveryType
  pickupTime      DateTime?    // if PICKUP
  deliveryAddress String?      // if DELIVERY
  deliveryCity    String?
  deliveryPostal  String?
  // Coordonnées du point de livraison. L'autocomplétion les fournit au moment
  // de la commande ; sans elles, aucune distance ni durée ne peut être
  // calculée pour le suivi.
  deliveryLat     Float?
  deliveryLng     Float?

  // Status
  status          OrderStatus  @default(PENDING)

  // Payment
  totalAmount     Decimal      @db.Decimal(10, 2)
  taxAmount       Decimal      @db.Decimal(10, 2)
  feesAmount      Decimal      @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?      // Stripe payment intent ID

  /// Le taux de TVA appliqué, tel qu'il valait au moment de la commande.
  ///
  /// `taxAmount` arrivait du navigateur et valait donc zéro : la taxe réglée par
  /// le commerçant n'était lue nulle part. Elle est maintenant calculée au
  /// serveur, et son taux conservé — un commerçant qui passe de 10 à 20 % ne
  /// doit pas réécrire la TVA de ses tickets déjà remis.
  taxRate         Decimal      @default(0) @db.Decimal(5, 2)

  /// La commission de la plateforme, figée à la commande.
  ///
  /// Elle se recalculait à chaque affichage de la facturation, au taux de la
  /// formule *actuelle* du commerçant : changer sa formule refacturait tout son
  /// historique au nouveau taux. Dans un sens la plateforme perdait de l'argent,
  /// dans l'autre elle en réclamait indûment.
  commissionPercent Decimal    @default(0) @db.Decimal(5, 2)
  commissionAmount  Decimal    @default(0) @db.Decimal(10, 2)
  /// La formule du commerçant à cet instant, pour expliquer le taux retenu.
  tierAtOrder       String?

  // Le code promo appliqué, et la remise qu'il a réellement accordée. Aucun des
  // deux n'était conservé : la remise disparaissait de la commande, et le
  // commerçant ne savait pas quel code avait été utilisé.
  promoCode       String?
  discountAmount  Decimal      @default(0) @db.Decimal(10, 2)

  // Le moyen de paiement choisi par le client parmi ceux du commerçant. Gardé
  // par identifiant et par nom : le nom reste lisible même si le commerçant
  // retire le moyen de paiement plus tard.
  paymentMethodId   String?
  paymentMethodName String?

  notes           String?

  // Soft delete
  deletedAt       DateTime?

  // Relations
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments        Payment[]
  delivery        OrderDelivery?
  invoice         Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  // selectedOptions is JSON: { optionId: choiceId }
  selectedOptions Json    @default("{}")
  price           Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  /// Le taux de TVA appliqué à cette ligne, tel qu'il valait à la commande.
  /// Permet d'afficher un récapitulatif multi-taux correct sur le ticket.
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  /// La taxe correspondante, en euros, extraite du prix TTC de la ligne.
  taxAmount       Decimal @default(0) @db.Decimal(10, 2)

  // Relations
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id              String       @id @default(cuid())
  orderId         String
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("EUR")
  status          PaymentStatus @default(PENDING)
  
  // Stripe info
  stripePaymentIntentId String?
  stripeClientSecret String?
  stripeStatus    String?      // requires_payment_method, succeeded, etc.
  
  paidAt          DateTime?

  // Relations
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId])
  @@index([stripePaymentIntentId])
}

// ============================================================================
// THEME & CUSTOMIZATION
// ============================================================================

model Theme {
  id      String  @id @default(cuid())
  storeId String  @unique
  
  // Design tokens (JSON)
  // {
  //   "colors": { "primary": "#FF0000", "secondary": "..." },
  //   "fonts": { "body": "Inter", "heading": "Poppins" }
  // }
  config  Json    @default("{}")
  
  // CSS (future: MVP uses only colors + fonts)
  customCss String?
  
  status  String  @default("draft") // draft | published

  // Relations
  store   Store   @relation("ThemeToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// DELIVERY & DRIVERS
// ============================================================================

model Driver {
  id              String    @id @default(cuid())
  userId          String?   @unique // Link to User account (optional)
  name            String
  email           String    @unique
  phone           String
  vehicleType     String    // car, scooter, bike
  vehiclePlate    String?
  licensePlate    String?   // Alias for vehiclePlate

  // Location
  latitude        Float?
  longitude       Float?
  lastLocationUpdate DateTime?

  /// PENDING, ACTIVE, REJECTED, SUSPENDED, INACTIVE.
  ///
  /// Un livreur naissait ACTIVE : il s'inscrivait et recevait une course dans
  /// la minute, sans que personne n'ait vu son permis. Il attend maintenant la
  /// validation de la plateforme — l'attribution n'ouvre les courses qu'aux
  /// ACTIVE.
  status          String    @default("PENDING")
  /// Quand la plateforme a validé le dossier, et qui.
  approvedAt      DateTime?
  approvedBy      String?
  /// Pourquoi le dossier a été refusé ou le compte suspendu, dit au livreur.
  statusReason    String?
  isOnline        Boolean   @default(false)
  isAvailable     Boolean   @default(true)
  currentOrderId  String?   // Current delivery

  // Ratings
  rating          Decimal   @default(5.0) @db.Decimal(3, 2)
  totalRatings    Int       @default(0)

  // Financial
  totalEarnings   Decimal   @default(0) @db.Decimal(10, 2)
  totalDeliveries Int       @default(0)

  // Relations
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries      OrderDelivery[]
  offers          DeliveryOffer[]
  documents       DriverDocument[]
  payouts         DriverPayout[]
  ratings         DriverRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isOnline])
  @@index([userId])
}

/// Une pièce du dossier d'un livreur : permis, assurance, carte grise.
///
/// Le modèle existait depuis le début sans qu'aucune route ne l'écrive ni ne le
/// lise : le dossier d'un livreur était vide, et sa validation impossible.
model DriverDocument {
  id              String    @id @default(cuid())
  driverId        String
  type            String    // license, insurance, vehicle_registration, identity
  /// Le document lui-même. L'hébergement de fichiers n'étant pas branché, le
  /// livreur fournit un lien ; le jour où un stockage existera, c'est ce champ
  /// qui le recevra.
  documentUrl     String
  expiryDate      DateTime?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  /// Le motif d'un refus, que le livreur doit pouvoir lire.
  reviewNote      String?
  reviewedAt      DateTime?

  // Relations
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([status])
}

model OrderDelivery {
  id              String    @id @default(cuid())
  orderId         String    @unique
  driverId        String?

  // Delivery details
  pickupTime      DateTime?
  deliveryTime    DateTime?
  estimatedTime   DateTime?
  actualTime      DateTime?

  // Adresses de la course : le retrait chez le commerçant, le dépôt chez le
  // client. Elles ne bougent pas une fois la course créée.
  pickupLat       Float?
  pickupLng       Float?
  deliveryLat     Float?
  deliveryLng     Float?

  // Adresse de livraison obfusquée pour protéger la confidentialité du client.
  // Le livreur reçoit ces coordonnées au lieu des vraies jusqu'à ce qu'il soit
  // assez proche (±200m) pour voir l'adresse exacte.
  deliveryLatObfusquee Float?
  deliveryLngObfusquee Float?

  // Position du livreur en chemin. Distincte des deux précédentes : elle était
  // écrite dans deliveryLat/Lng, ce qui effaçait l'adresse du client à chaque
  // envoi de position.
  driverLat       Float?
  driverLng       Float?
  driverLocationAt DateTime?

  // Status
  status          String    @default("PENDING") // PENDING, ACCEPTED, PICKED_UP, DELIVERED, FAILED

  // Rémunération, figée à l'attribution pour que le livreur sache ce qu'il
  // accepte, et jamais recalculée ensuite.
  distanceKm      Float?
  driverPayout    Decimal?  @db.Decimal(10, 2)
  platformFee     Decimal?  @db.Decimal(10, 2)
  assignedAt      DateTime?

  /// La preuve de la remise.
  ///
  /// Une course passait à DELIVERED sur simple clic du livreur : rien ne
  /// distinguait un colis remis en main propre d'un colis jamais sorti du sac.
  /// Le client reçoit un code à quatre chiffres qu'il donne à la porte ; à
  /// défaut, le livreur photographie le dépôt.
  deliveryCode    String?
  /// Essais de code ratés. Quatre chiffres se forcent en dix mille tentatives :
  /// passé cinq essais le code se bloque, et seule la photo reste.
  codeAttempts    Int       @default(0)
  /// CODE ou PHOTO : par quoi la remise a été prouvée.
  proofType       String?
  proofPhoto      String?   // Photo du dépôt, quand le client est absent
  proofNote       String?
  proofAt         DateTime?

  /// Le relevé de versement qui paie cette course.
  ///
  /// Tant qu'il est vide, la course est due au livreur. C'est ce lien qui
  /// garantit qu'une course n'est payée qu'une fois : un relevé ne prend que
  /// les courses qui n'en ont pas.
  payoutId        String?

  // Annulation de course
  cancelledBy     String?   // DRIVER, RESTAURANT, CLIENT, SYSTEM
  cancellationReason String?

  // Relations
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver          Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  offers          DeliveryOffer[]
  payout          DriverPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  rating          DriverRating?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([driverId])
  @@index([status])
  @@index([payoutId])
}

/// Un relevé de versement : ce que la plateforme doit à un livreur, puis ce
/// qu'elle lui a versé.
///
/// Les gains d'un livreur s'accumulaient course après course dans
/// `Driver.totalEarnings`, sans que rien ne les paie : ni période, ni relevé,
/// ni trace de versement. Un livreur ne pouvait pas savoir si les 340 € qu'on
/// lui annonçait étaient déjà sur son compte ou toujours dus.
model DriverPayout {
  id              String    @id @default(cuid())
  driverId        String

  /// La période couverte, bornes incluses côté début, exclues côté fin.
  periodStart     DateTime
  periodEnd       DateTime

  /// Figés à la création : un relevé dit ce qui a été arrêté ce jour-là, il ne
  /// se recalcule pas si une course change plus tard.
  deliveryCount   Int       @default(0)
  amount          Decimal   @default(0) @db.Decimal(10, 2)

  /// PENDING (arrêté, à verser), PAID (versé), CANCELLED (annulé).
  status          String    @default("PENDING")

  /// Comment le versement a été fait, pour que le livreur puisse le retrouver
  /// sur son relevé bancaire.
  method          String?
  reference       String?
  paidAt          DateTime?
  paidBy          String?
  note            String?

  // Relations
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deliveries      OrderDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([periodStart])
}

// Proposition d'une course à un livreur.
//
// Une course est proposée à un livreur à la fois, au plus proche d'abord, avec
// un délai pour répondre. Passé ce délai elle part au suivant. Garder la trace
// de chaque proposition évite de re-solliciter quelqu'un qui a déjà refusé, et
// permet de comprendre après coup pourquoi une course est restée sans preneur.
model DeliveryOffer {
  id          String    @id @default(cuid())
  deliveryId  String
  driverId    String

  status      String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED, CANCELLED

  // Ce que le livreur voit avant d'accepter.
  distanceKm  Float?
  payout      Decimal?  @db.Decimal(10, 2)

  offeredAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  delivery    OrderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driver      Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un livreur n'est sollicité qu'une fois par course.
  @@unique([deliveryId, driverId])
  @@index([driverId, status])
  @@index([status, expiresAt])
}

// ============================================================================
// DELIVERY ZONES
// ============================================================================

// Une zone de livraison : un anneau autour de la boutique, avec ses frais et
// son montant minimum de commande.
//
// Le modèle existait avec un nom, des frais et un minimum, mais sans géométrie
// utilisable — un point sans rayon — et rien ne l'appliquait : la commande
// ignorait les zones, facturait les frais forfaitaires de la boutique et
// acceptait n'importe quel montant, où que soit le client.
enum DeliveryZoneType {
  RADIUS
  POLYGON
}

model DeliveryZone {
  id        String  @id @default(cuid())
  storeId   String
  name      String

  /// RADIUS : un anneau simple, réglé au kilomètre. POLYGON : une forme
  /// dessinée à la main sur la carte, pour coller à une rue, un pont, une
  /// limite de quartier qu'un cercle ne peut pas suivre.
  type      DeliveryZoneType @default(RADIUS)

  // Rayon en kilomètres depuis la boutique. Uniquement pour le type RADIUS ;
  // les anneaux se recouvrent, c'est le plus petit qui contient l'adresse qui
  // s'applique, comme chez Uber Eats.
  radiusKm  Float?

  // Durée de livraison annoncée au client pour cette zone.
  deliveryMinutes Int? 

  // Une zone désactivée n'est plus livrée, sans perdre son réglage.
  isActive  Boolean @default(true)

  /// Uniquement pour le type POLYGON : la liste des sommets, dans l'ordre où
  /// ils ont été posés — [{ lat, lng }, { lat, lng }, ...], au moins 3.
  polygon   Json?

  /// Couleur de la zone sur la carte (hex, ex. "#f59e0b"). Chaque zone la
  /// sienne, pour distinguer les recouvrements d'un coup d'œil.
  color     String  @default("#f59e0b")

  /// Opacité du remplissage (0.1 à 0.9) : assez transparent pour voir les
  /// zones se superposer, assez opaque pour rester lisible.
  opacity   Float   @default(0.35)

  baseFee   Decimal @db.Decimal(10, 2)
  minOrder  Decimal @db.Decimal(10, 2)

  // Relations
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// ============================================================================
// PROMOTIONS
// ============================================================================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id          String          @id @default(cuid())
  storeId     String
  code        String
  description String?
  type        PromotionType
  discountType String         @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  discountValue Decimal       @db.Decimal(10, 2)

  // Scope: which products/categories apply to
  applicableToAll Boolean      @default(true)
  productIds  String[]        @default([])
  categoryIds String[]        @default([])

  // Validity
  startDate   DateTime?
  endDate     DateTime?
  expiresAt   DateTime?
  isActive    Boolean         @default(true)

  /// Heure de début d'activation au format HH:MM (ex : "12:00").
  /// NULL = aucune restriction horaire.
  activeFromTime String?
  /// Heure de fin d'activation au format HH:MM (ex : "14:00").
  activeToTime   String?
  /// Jours de la semaine actifs : 0 = dimanche … 6 = samedi.
  /// Tableau vide = tous les jours.
  activeDays     Int[]   @default([])

  // Limits
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxUses     Int?            // null = unlimited
  maxUsesPerCustomer Int?
  currentUses Int             @default(0)
  timesUsed   Int             @default(0)

  status      String          @default("ACTIVE") // ACTIVE, INACTIVE, EXPIRED

  // Relations
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
  @@index([status])
}

// ============================================================================
// STAFF MANAGEMENT
// ============================================================================

enum StaffRole {
  MANAGER
  CASHIER
  KITCHEN
  DELIVERY
  SUPPORT
}

model Staff {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  email       String
  phone       String?
  role        StaffRole @default(CASHIER)
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED

  // Optional: link to user account if staff has login
  userId      String?

  // Permissions (JSON array of action strings)
  permissions Json      @default("[]")

  // Relations
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
  @@index([status])
}

// ============================================================================
// FAVORITES & PREFERENCES
// ============================================================================

model FavoriteStore {
  id        String  @id @default(cuid())
  customerId String
  storeId   String

  // Relations
  customer  Customer @relation("CustomerFavorites", fields: [customerId], references: [id], onDelete: Cascade)
  store     Store   @relation("StoreFavorites", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, storeId])
  @@index([customerId])
  @@index([storeId])
}

// ============================================================================
// CUSTOMERS (GLOBAL - SHARED ACROSS ALL STORES)
// ============================================================================

model Customer {
  id              String    @id @default(cuid())

  // REFONTE IDENTITÉ UNIFIÉE: Lien avec User (nullable pour transition)
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // GLOBAL CLIENT - peut commander chez tous les restaurants
  // Déprécié : utiliser user.name, user.email, user.phone
  name            String
  email           String    @unique
  phone           String?
  address         String?
  city            String?
  postalCode      String?
  latitude        Float?    // Géolocalisation optionnelle
  longitude       Float?

  // Customer info
  totalOrders     Int       @default(0)
  totalSpent      Decimal   @default(0) @db.Decimal(10, 2)
  lastOrderDate   DateTime?

  // Notes (internal)
  notes           String?

  // Status
  status          String    @default("ACTIVE") // ACTIVE, BLOCKED, INACTIVE

  // Soft delete
  deletedAt       DateTime?

  // Relations
  orders          Order[]
  reviews         Review[] @relation("ReviewToCustomer")
  driverRatings   DriverRating[]
  favorites       FavoriteStore[] @relation("CustomerFavorites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

// ============================================================================
// REVIEWS & RATINGS
// ============================================================================

/// La note qu'un client donne à son livreur, une fois la course remise.
///
/// `Driver.rating` valait 5,00 pour tout le monde depuis le premier jour :
/// c'était la valeur par défaut de la colonne, et rien ne l'écrivait jamais.
/// Le livreur voyait « 5 » sur son tableau de bord sans avoir jamais été noté,
/// l'attribution ne pouvait pas s'en servir pour départager, et la plateforme
/// n'avait aucune prise sur un livreur qui se conduit mal.
///
/// Une note par course, et par la course : c'est `deliveryId` qui est unique,
/// pas le couple client/livreur. Un client qui commande dix fois note dix fois,
/// et ne peut pas noter deux fois la même course.
model DriverRating {
  id          String   @id @default(cuid())
  deliveryId  String   @unique
  driverId    String
  /// Le client qui a noté. Nul si sa fiche disparaît : la note reste, sinon la
  /// moyenne du livreur bougerait à la suppression d'un compte.
  customerId  String?

  /// De 1 à 5. Entier : une demi-étoile ne se donne pas.
  note        Int
  commentaire String?

  delivery    OrderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driver      Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([customerId])
}

model Review {
  id          String  @id @default(cuid())
  storeId     String
  productId   String
  customerId  String?

  rating      Int     @default(5) // 1-5 stars
  comment     String?
  helpfulCount Int    @default(0)

  status      String  @default("PENDING") // PENDING, APPROVED, REJECTED

  // Relations
  store       Store   @relation("ReviewToStore", fields: [storeId], references: [id], onDelete: Cascade)
  product     Product @relation("ReviewToProduct", fields: [productId], references: [id], onDelete: Cascade)
  customer    Customer? @relation("ReviewToCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// MARKETING CAMPAIGNS
// ============================================================================

enum CampaignType {
  EMAIL
  SMS
  PUSH
  INAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model MarketingCampaign {
  id              String        @id @default(cuid())
  storeId         String

  name            String
  description     String?
  type            CampaignType
  message         String

  // Target audience
  targetAudience  String        @default("all") // all, new, returning, inactive

  // Scheduling
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  // Statistics
  sentCount       Int           @default(0)
  openCount       Int           @default(0)
  clickCount      Int           @default(0)
  conversionCount Int           @default(0)

  // Relations
  store           Store         @relation("CampaignToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// TAX SETTINGS
// ============================================================================

model TaxSetting {
  id              String  @id @default(cuid())
  storeId         String

  name            String  // "VAT 20%", "TVA"
  rate            Decimal @db.Decimal(5, 2) // 20.00 for 20%

  /// La taxe est-elle déjà comprise dans le prix affiché ?
  ///
  /// En France comme en Belgique, un prix montré à un particulier est TTC : la
  /// TVA s'extrait du prix, elle ne s'ajoute pas par-dessus au moment de payer.
  /// C'est donc la valeur par défaut. `false` pour une facturation hors taxes,
  /// où le taux s'ajoute au total.
  included        Boolean @default(true)

  // Scope
  applicableTo    String  @default("all") // all, categories, products
  categoryIds     String[] @default([])
  productIds      String[] @default([])

  // Status
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE

  // Relations
  store           Store   @relation("TaxSettingToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([status])
}

// ============================================================================
// PAYMENT METHODS
// ============================================================================

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  STRIPE
  BANK_TRANSFER
  CASH
  APPLE_PAY
  GOOGLE_PAY
}

model PaymentMethod {
  id              String          @id @default(cuid())
  storeId         String
  userId          String?         // For customer payment methods

  type            PaymentMethodType
  name            String          // "Stripe Card", "PayPal"

  // Stripe specific
  stripePaymentMethodId String?   @unique
  stripeCustomerId String?

  // Configuration (JSON)
  // For Stripe: { apiKey, secretKey, webhookSecret }
  // For PayPal: { clientId, clientSecret }
  // For Bank: { accountNumber, routingNumber, bankName }
  config          Json            @default("{}")

  // Status
  isDefault       Boolean         @default(false)
  isActive        Boolean         @default(true)

  // Commission/fees
  commissionPercent Decimal       @default(0) @db.Decimal(5, 2)
  fixedFee        Decimal         @default(0) @db.Decimal(10, 2)

  // Relations
  store           Store           @relation("PaymentMethodToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([isActive])
  @@index([userId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  ORDER_PLACED
  ORDER_DELIVERED
  DELIVERY_CANCELLED
  PROMOTION_AVAILABLE
  STOCK_LOW
  REVIEW_RECEIVED
  PAYMENT_FAILED
  PAYMENT_SUCCEEDED
  TICKET_MESSAGE
  // Annonce diffusée par l'administration de la plateforme
  PLATFORM_ANNOUNCEMENT
}

model Notification {
  id              String            @id @default(cuid())
  // Optionnel : une notification de ticket ne dépend d'aucune boutique
  storeId         String?

  type            NotificationType
  title           String
  message         String
  recipientEmail  String

  // Lien profond ouvert au clic sur la notification
  link            String?

  // Diffusion par l'administration : niveau d'urgence et public visé
  priority        String            @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  targetAudience  String            @default("ALL")    // ALL, MERCHANTS, CUSTOMERS, DRIVERS

  // Status
  isRead          Boolean           @default(false)
  sentAt          DateTime?
  readAt          DateTime?

  // Metadata
  relatedOrderId  String?
  relatedProductId String?

  // Relations
  store           Store?            @relation("NotificationToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// PRODUCT VARIANTS & MEDIA
// ============================================================================

model ProductMedia {
  id              String  @id @default(cuid())
  productId       String

  url             String
  alt             String?
  type            String  @default("image") // image, video
  displayOrder    Int     @default(0)

  // Relations
  product         Product @relation("MediaToProduct", fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([displayOrder])
}

// ============================================================================
// PRODUCT SEO & TAGS
// ============================================================================

model ProductSeo {
  id              String  @id @default(cuid())
  productId       String  @unique

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  slug            String
  ogImage         String?
  ogDescription   String?

  // Relations
  product         Product @relation("SeoToProduct", fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@unique([slug])
}

model ProductTag {
  id              String  @id @default(cuid())
  storeId         String

  name            String
  slug            String
  description     String?
  color           String? // Hex color for UI

  // Product association (JSON array of product IDs)
  productIds      String[] @default([])

  // Relations
  store           Store   @relation("TagToStore", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

// ============================================================================
// PLATEFORME : CLÉS API, WEBHOOKS, SAUVEGARDES, SÉCURITÉ
// ============================================================================

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  // Début lisible de la clé (ex. sk_live_a1b2c3) : la clé complète n'est
  // affichée qu'une fois, seul son hachage est conservé.
  prefix      String
  keyHash     String    @unique
  status      String    @default("ACTIVE") // ACTIVE, REVOKED
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?

  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([prefix])
}

model Webhook {
  id            String    @id @default(cuid())
  url           String
  events        String[]  @default([])
  // Sert à signer chaque envoi pour que le destinataire puisse le vérifier.
  secret        String
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, FAILED
  lastTriggered DateTime?
  retryCount    Int       @default(0)
  createdById   String?

  deliveries    WebhookDelivery[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  success    Boolean  @default(false)
  error      String?

  // Une ligne par événement, pas par tentative : elle porte le compte des
  // essais et la date du prochain. Un envoi raté se retentait nulle part —
  // un destinataire redémarré perdait la commande pour de bon.
  attempt       Int       @default(1)
  // Rempli tant qu'une relance est due ; vidé dès que l'envoi aboutit ou que
  // les relances sont épuisées. C'est la file d'attente, et elle est en base :
  // un `setTimeout` n'aurait pas survécu au redémarrage du serveur.
  nextAttemptAt DateTime?
  abandonedAt   DateTime?

  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([webhookId])
  @@index([createdAt])
  @@index([nextAttemptAt])
}

model Backup {
  id          String    @id @default(cuid())
  name        String
  sizeBytes   Int       @default(0)
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  filePath    String?
  error       String?
  createdById String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
  @@index([status])
}


// ============================================================================
// FACTURATION
// ============================================================================

/// Compteur de numéros de facture par boutique, par an et par série.
model InvoiceSeq {
  id      String @id @default(cuid())
  storeId String
  year    Int
  serie   String @default("FAC")
  last    Int    @default(0)

  store   Store  @relation("InvoiceSeqToStore", fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, year, serie])
  @@index([storeId])
}

/// Une facture émise, figée au moment de l'émission.
model Invoice {
  id        String   @id @default(cuid())
  number    String
  storeId   String
  orderId   String   @unique
  issuedAt  DateTime @default(now())

  emetteurJson     Json @default("{}")
  destinataireJson Json @default("{}")
  lignesJson       Json @default("[]")

  subtotal  Decimal  @default(0) @db.Decimal(10, 2)
  /// Détail de la TVA par taux : [{ taux, base, taxe, nom }]
  taxJson   Json     @default("[]")
  taxTotal  Decimal  @default(0) @db.Decimal(10, 2)
  fees      Decimal  @default(0) @db.Decimal(10, 2)
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  total     Decimal  @default(0) @db.Decimal(10, 2)

  store     Store    @relation("InvoiceToStore",  fields: [storeId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id],  onDelete: Restrict)

  @@unique([number, storeId])
  @@index([storeId])
  @@index([issuedAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  action    String   // LOGIN_FAILED, LOGIN_SUCCESS, ADMIN_GRANTED...
  actor     String   // email concerné, ou "anonyme"
  target    String   @default("")
  severity  String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status    String   @default("SUCCESS") // SUCCESS, FAILED, WARNING
  details   String   @default("")
  ipAddress String?
  /// Le navigateur ou l'outil employé. La colonne manquait, et la page
  /// affichait « — » pour tout le monde.
  userAgent String?
  /// Temps de traitement de la requête, en millisecondes. La page affichait une
  /// colonne « durée » toujours à zéro : rien ne la mesurait.
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity])
  @@index([action])
}
