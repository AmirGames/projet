# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_dev?schema=public"

# Node environment
NODE_ENV=development

# Server
PORT=3001
API_URL=http://localhost:3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Logging
LOG_LEVEL=debug

# Feature flags
ENABLE_STRIPE=true
ENABLE_EMAIL_VERIFICATION=true

# Allowed origins for CORS
ALLOWED_ORIGINS=

# Site URL for email links
SITE_URL=http://localhost:3000

# Email configuration (Mailpit for development)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@monsite.fr

# Email verification
ENABLE_EMAIL_VERIFICATION=true
REQUIRE_EMAIL_VERIFICATION=false

# Prisma logging
PRISMA_LOG_QUERIES=false

# Address provider
ADDRESS_PROVIDER=ban+photon
ADDRESS_COUNTRIES=fr,be

# Google Maps API (optional)
GOOGLE_MAPS_API_KEY=
